    return false
end

local function isItemAreaDangerous(itemPos)
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if not monstersFolder then return false end

    local activeSafeDist  = math.max(Config.Pickup.ItemMonsterSafeDist or 26, (Config.Teleport.SafeRadius or 22) + 4)
    local passiveSafeDist = math.max((Config.Teleport.LooseRadius or 10) - 1, 8.5)
    local lethalSafeDist  = Config.Teleport.LethalRadius or 60

    for _, m in pairs(monstersFolder:GetChildren()) do
        if m:IsA("Model") then
            local mp = getMonsterPart(m)
            if mp then
                local distToItem = Vector2.new(mp.Position.X - itemPos.X, mp.Position.Z - itemPos.Z).Magnitude
                local isLethal   = isLethalMonsterName(m.Name)
                local reqDist    = isLethal and lethalSafeDist or (isLooseMonsterName(m.Name) and passiveSafeDist or activeSafeDist)

                if distToItem <= reqDist then
                    return true
                end

                if not isLooseMonsterName(m.Name) and rootPart then
                    local pA = rootPart.Position
                    local ab = itemPos - pA
                    local lenSq = ab.X * ab.X + ab.Z * ab.Z
                    if lenSq > 1 then
                        local t = math.clamp(((mp.Position.X - pA.X) * ab.X + (mp.Position.Z - pA.Z) * ab.Z) / lenSq, 0, 1)
                        local closestPt = pA + ab * t
                        local distToLine = Vector2.new(closestPt.X - mp.Position.X, closestPt.Z - mp.Position.Z).Magnitude
                        local lineReq = isLethal and (lethalSafeDist - 5) or ((Config.Teleport.SafeRadius or 22) + 2)
                        if distToLine <= lineReq then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function getMinDistanceToMonsters(pt)
    local minDist = math.huge
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") then
                local p = getMonsterPart(m)
                if p then
                    local d = (p.Position - pt).Magnitude
                    if d < minDist then minDist = d end
                end
            end
        end
    end
    return minDist
end

