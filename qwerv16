local function executePickup()
    if not Config.Pickup.Enable then return end
    local map = getMap()
    if not map then return end

    applyItemESP()
    updateColliderCaches(false)

    local skipCounts    = {}
    local cooldownUntil = {}

    local function makePlatform(atPos)
        local plat = Instance.new("Part")
        plat.Size         = Vector3.new(10, 1, 10)
        plat.Anchored     = true
        plat.CanCollide   = true
        plat.Transparency = 1
        plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
        plat.Parent       = Workspace
        return plat
    end

    local function getSortedCandidateItems()
        local safeList    = {}
        local guardedList = {}
        local curMap      = getMap()
        local folder      = curMap and curMap:FindFirstChild("Items")
        if not folder or not rootPart then return safeList, guardedList end

        local now   = os.clock()
        local rpPos = rootPart.Position

        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Model") and item.Parent and not isIgnored(item.Name) and not item:GetAttribute("BlacklistLimbo") then
                local tier = getItemPriorityTier(item.Name)
                if tier ~= nil then
                    local itemPos       = item:GetPivot().Position
                    local dist          = (rpPos - itemPos).Magnitude
                    local attrCd        = item:GetAttribute("MonsterItemCooldown") or 0
                    local isOnCooldown  = (cooldownUntil[item] and now < cooldownUntil[item]) or (now < attrCd)
                    local isDangerous   = isOnCooldown or isItemAreaDangerous(itemPos)
                    local weightedScore = dist + ((tier - 1) * 30)

                    local entry = {
                        instance = item,
                        name     = item.Name,
                        tier     = tier,
                        pos      = itemPos,
                        dist     = dist,
                        score    = weightedScore,
                    }

                    if isDangerous then
                        if now >= attrCd then
                            item:SetAttribute("MonsterItemCooldown", now + 5.0)
                        end
                        table.insert(guardedList, entry)
                    else
                        table.insert(safeList, entry)
                    end
                end
            end
        end

        local function sortFn(a, b) return a.score < b.score end
        table.sort(safeList, sortFn)
        table.sort(guardedList, sortFn)
        return safeList, guardedList
    end

    while isMasterFarming and not abortCurrentMovement do
        -- [PERBAIKAN MUTLAK POIN #1 - PANIC TIME]:
        -- Jika semua mesin sudah selesai DAN waktu hitung mundur lift sudah menyentuh <= PanicTime (misal <= 5 detik),
        -- WAJIB hentikan ambil barang detik ini juga dan langsung teleport ke Real Elevator!
        local panicReached, secLeft = isPanicDeadlineReached()
        if panicReached then
            print(string.format("[PANIC TIME] Sisa waktu lift %d detik (<= %d detik)! Menghentikan ambil item & wajib masuk Real Elevator!", secLeft, Config.Teleport.PanicTime or 5))
            break
        end

        -- Jika punya VeeRemote & masih berstatus "Active", dahulukan mesin pertama
        if Config.Teleport.UseVeeRemoteFirst and isTrinketActive() and hasUncompletedGeneratorsInMap() then
            print("[VEE REMOTE LOCK] Status VeeRemote masih 'Active'! Membatalkan ambil item & kembali ke Lever Generator...")
            break
        end

        if isThreatened() then
            local okHide = performColliderHide("Ter-spot monster saat proses Pickup Item!")
            if not okHide or abortCurrentMovement or not isMasterFarming then break end
        end

        local safeCandidates, guardedCandidates = getSortedCandidateItems()
        if #safeCandidates == 0 and #guardedCandidates == 0 then
            break
        end

        local chosen = safeCandidates[1]

        if not chosen then
            if Config.Pickup.MovementMode == "Instant" then
                chosen = guardedCandidates[1]
            else
                print("[SMART PICKUP] Sisa item dekat monster. Langsung beralih ke Generator/Elevator tanpa bengong...")
                break
            end
        end

        local item       = chosen.instance
        local itemPos    = chosen.pos
        local itemStandY = getTargetStandingY(itemPos.Y, false)
        local targetCF   = CFrame.new(itemPos.X, itemStandY, itemPos.Z)

        local switchedToOtherItem = false
        local veeTriggeredMidWay  = false
        local panicTriggeredMid   = false

        local function shouldRerouteToSaferItem()
            if not item or not item.Parent then return true end
            -- Batalkan jalan di tengah rute jika waktu PanicTime lift sudah mencapai batas (<= 5 detik)!
            if isPanicDeadlineReached() then
                panicTriggeredMid = true
                return true
            end
            if Config.Teleport.UseVeeRemoteFirst and isTrinketActive() and hasUncompletedGeneratorsInMap() then
                veeTriggeredMidWay = true
                return true
            end
            if Config.Pickup.MovementMode == "Tween" and isItemAreaDangerous(item:GetPivot().Position) then
                cooldownUntil[item] = os.clock() + 5.0
                item:SetAttribute("MonsterItemCooldown", os.clock() + 5.0)
                switchedToOtherItem = true
                return true
            end
            return false
        end

        local moveInterrupted = false
        if Config.Pickup.MovementMode == "Instant" then
            teleportplr(targetCF, false)
        else
            moveInterrupted = safeSingleLayerTween(targetCF, Config.Pickup.TweenSpeed, false, shouldRerouteToSaferItem)
        end

        if abortCurrentMovement or not isMasterFarming then break end

        if panicTriggeredMid or isPanicDeadlineReached() then
            print("[PANIC TIME] Batas waktu lift tercapai di tengah jalan! Langsung menuju Real Elevator...")
            break
        end

        if veeTriggeredMidWay then
            print("[VEE REMOTE LOCK] VeeRemote masih 'Active'! Berbelok ke Lever Generator...")
            break
        end

        if isThreatened() then
            local okHide = performColliderHide("Ter-spot saat jalan menuju item " .. chosen.name .. "!")
            if not okHide or abortCurrentMovement or not isMasterFarming then break end
            task.wait(0.05)
            continue
        end

        if not item or not item.Parent then
            task.wait(0.02)
            continue
        end

        if switchedToOtherItem then
            print("[SMART PICKUP] Monster mendekati " .. chosen.name .. "! Beralih ke item aman lain...")
            task.wait(0.04)
            continue
        end

        local horizDist = Vector2.new(rootPart.Position.X - itemPos.X, rootPart.Position.Z - itemPos.Z).Magnitude
        if moveInterrupted or horizDist > 11.5 then
            skipCounts[item] = (skipCounts[item] or 0) + 1
            if skipCounts[item] >= 3 and not isPriority(item.Name) then
                item:SetAttribute("BlacklistLimbo", true)
            end
            task.wait(0.05)
            continue
        end

        local holdTargetPos      = rootPart.Position
        local plat               = makePlatform(holdTargetPos)
        local holdPickupConn     = startServerSyncedHold(function() return holdTargetPos end)
        local waitTicks          = 0
        local monsterInterrupted = false

        while item.Parent and waitTicks < 14 and not abortCurrentMovement and isMasterFarming do
            if isPanicDeadlineReached() then
                panicTriggeredMid = true
                break
            end
            if isThreatened() then
                monsterInterrupted = true
                break
            end
            if Config.Pickup.MovementMode == "Tween" and isItemAreaDangerous(itemPos) then
                cooldownUntil[item] = os.clock() + 5.0
                item:SetAttribute("MonsterItemCooldown", os.clock() + 5.0)
                switchedToOtherItem = true
                break
            end

            local pp   = item:FindFirstChild("Prompt")
            local prox = pp and pp:FindFirstChild("ProximityPrompt")
            if prox and prox.Enabled then
                interactWithPrompt(prox)
            end

            task.wait(0.06)
            waitTicks = waitTicks + 1
        end

        if holdPickupConn then holdPickupConn:Disconnect(); holdPickupConn = nil end
        clearAllServerSyncedHolds()
        if plat and plat.Parent then plat:Destroy() end
        if rootPart then rootPart.Anchored = false end

        if panicTriggeredMid or isPanicDeadlineReached() then
            break
        end

        if monsterInterrupted or isThreatened() then
            local okHide = performColliderHide("Ter-spot saat memungut item " .. chosen.name .. "!")
            if not okHide or abortCurrentMovement or not isMasterFarming then break end
            task.wait(0.05)
            continue
        end

        if switchedToOtherItem then
            task.wait(0.04)
            continue
        end

        if item.Parent then
            skipCounts[item] = (skipCounts[item] or 0) + 1
            if skipCounts[item] >= 2 then
                if isPriority(item.Name) then
                    print("[SYSTEM] Item Priority " .. item.Name .. " belum terambil, akan dicoba lagi.")
                else
                    print("[SYSTEM] Gagal mengambil " .. item.Name .. " (Tas Penuh). Masuk Blacklist lantai ini.")
                    item:SetAttribute("BlacklistLimbo", true)
                    local highlight = item:FindFirstChild("ItemESP")
                    if highlight then highlight.FillColor = Color3.fromRGB(255, 0, 0) end
                end
            end
        end

        restoreNormalGravity()
        task.wait(0.03)
    end

    clearAllServerSyncedHolds()
    if rootPart then rootPart.Anchored = false end
    setTargetColliderPassable(nil, false)
    restoreNormalGravity()
    print("[DONE] Pengambilan item selesai.")
end

-- ==============================================================================
-- [SECTION 9] GENERATOR AUTO-FARM (DUALGEN 2P + PANICTIME + VEE REMOTE VERIFY)
-- ==============================================================================
local function startAutoFarming()
    farmingSessionId      = farmingSessionId + 1
    local mySession       = farmingSessionId
    inElevatorStandby     = false
    hasVerifiedInElevator = false
    isReadyToTriggerGen   = false

    -- Thread 1: Loop Update ESP & Visual Radius
    task.spawn(function()
        while isMasterFarming and farmingSessionId == mySession do
            updateGeneratorESP()
            updateMonsterESP() 
            updateSafeRadiusVisual()
            applyItemESP()
            task.wait(0.2)
        end
        clearSafeRadiusVisual()
    end)

    -- Thread 2: Loop Auto-Skillcheck Override
    task.spawn(function()
        while isMasterFarming and farmingSessionId == mySession do
            if Config.Skillcheck and Config.Skillcheck.Enable then
                pcall(function()
                    local events = ReplicatedStorage:FindFirstChild("Events")
                    if events then
                        local su = events:FindFirstChild("SkillcheckUpdate")
                        if su then su.OnClientInvoke = function() return true end end
                    end
                end)
            end
            task.wait(1)
        end
    end)

    -- Thread 3: Main Generator Farming Loop
    task.spawn(function()
        while isMasterFarming and farmingSessionId == mySession do
            if isItemFarmingActive or isEmergencyHiding then
                isReadyToTriggerGen = false
                task.wait(0.05)
                continue
            end

            character = player.Character
            if not character then task.wait(0.2) continue end
            rootPart = character:FindFirstChild("HumanoidRootPart")
            if not rootPart then task.wait(0.2) continue end

            if Config.Teleport.Enable then
                local map = getMap()
                if map then
                    local genFolder = map:FindFirstChild("Generators")
                    if genFolder then

                        local uncompletedCount  = 0
                        local candidateGens     = {}
                        local fallbackEmptyGens = {}
                        local genSafeRad        = Config.Teleport.GeneratorSafeRadius or 18
                        local nowClock          = os.clock()
                        local veeActiveNow      = Config.Teleport.UseVeeRemoteFirst and isTrinketActive()

                        for _, gen in pairs(genFolder:GetChildren()) do
                            if gen:IsA("Model") then
                                local stats = gen:FindFirstChild("Stats")
                                if stats then
                                    local completed = stats:FindFirstChild("Completed") and stats.Completed.Value
                                    local connie    = stats:FindFirstChild("Connie") and stats.Connie.Value
                                    local campedCd  = gen:GetAttribute("MonsterCampedUntil") or 0

                                    if not completed then
                                        uncompletedCount = uncompletedCount + 1
                                        -- isMachineOccupied otomatis mengecek:
                                        -- - Jika veeActiveNow == true -> wajib 0 pemain lain (benar-benar kosong)
                                        -- - Jika normal & DualGen -> boleh masuk selama pemain lain < 2
                                        -- - Jika normal & Generator biasa -> wajib 0 pemain lain
                                        if not connie and not isMachineOccupied(gen, Config.Teleport.PlayerRadius, veeActiveNow) then
                                            local genCF = getGeneratorTargetCFrame(gen)
                                            if genCF then
                                                local gPos        = genCF.Position
                                                local dist        = (rootPart.Position - gPos).Magnitude
                                                local monsterDist = getMinDistanceToMonsters(gPos)
                                                local nearLethal  = isNearLethalMonster(gPos, 2)

                                                if not nearLethal and nowClock >= campedCd and not isThreatened(gPos, genSafeRad) then
                                                    table.insert(candidateGens, { gen = gen, cf = genCF, dist = dist, mDist = monsterDist })
                                                elseif not nearLethal and monsterDist > 15 then
                                                    table.insert(fallbackEmptyGens, { gen = gen, cf = genCF, dist = dist, mDist = monsterDist })
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        if #candidateGens == 0 and #fallbackEmptyGens > 0 then
                            table.sort(fallbackEmptyGens, function(a, b) return a.mDist > b.mDist end)
                            table.insert(candidateGens, fallbackEmptyGens[1])
                        end

                        table.sort(candidateGens, function(a, b) return a.dist < b.dist end)
                        local chosenEntry  = candidateGens[1]
                        local targetGen    = chosenEntry and chosenEntry.gen
                        local targetCFrame = chosenEntry and chosenEntry.cf

                        local curGenUI, totGenUI = getMachineProgress()
                        local isFloorActuallyDone = false

                        if curGenUI ~= -1 and totGenUI ~= -1 and totGenUI > 0 then
                            isFloorActuallyDone = (curGenUI >= totGenUI)
                        else
                            isFloorActuallyDone = (uncompletedCount == 0 and #genFolder:GetChildren() > 0)
                        end

                        -- ======================================================================
                        -- [PERBAIKAN MUTLAK POIN #1]: LOGIKA SELESAI MESIN + PANIC TIME + SAPU ITEM
                        -- ======================================================================
                        if isFloorActuallyDone then
                            currentTargetGenerator = nil
                            isReadyToTriggerGen    = false

                            local panicDeadline, secRemaining = isPanicDeadlineReached()
                            local hasRemainingItems           = hasSafePickableItemsInMap()

                            -- Jika masih ada item aman (misal ResearchCapsule) DAN waktu lift masih > PanicTime (misal > 5 detik),
                            -- JANGAN kunci di lift dulu! Biarkan Section 10 mengambil sisa item terlebih dahulu!
                            if hasRemainingItems and not panicDeadline then
                                inElevatorStandby     = false
                                hasVerifiedInElevator = false
                                task.wait(0.1)
                                continue
                            end

                            -- Jika sudah tidak ada item lagi ATAU waktu lift sudah <= PanicTime (<= 5 detik),
                            -- WAJIB langsung masuk ke Real Elevator!
                            if not inElevatorStandby then
                                if panicDeadline then
                                    print(string.format("[PANIC TIME] Sisa waktu lift %s detik (<= %d detik)! Wajib langsung masuk Real Elevator!", tostring(secRemaining), Config.Teleport.PanicTime or 5))
                                else
                                    print("[INFO] Semua Mesin & Item Selesai! Menuju Real Elevator & Mematikan Monster Evasion...")
                                end
                                inElevatorStandby     = true
                                hasVerifiedInElevator = false
                            end

                            local elevatorTarget = getRealElevatorCFrame()
                            if elevatorTarget then
                                local dist = Vector2.new(rootPart.Position.X - elevatorTarget.Position.X, rootPart.Position.Z - elevatorTarget.Position.Z).Magnitude
                                if Config.Teleport.ForceLockInElevator then
                                    if dist > 4.5 then
                                        teleportplr(elevatorTarget, false)
                                    else
                                        if rootPart.Anchored then rootPart.Anchored = false end
                                    end
                                else
                                    if not hasVerifiedInElevator then
                                        teleportplr(elevatorTarget, false)
                                        task.wait(0.15)
                                        if rootPart then
                                            local checkDist = Vector2.new(rootPart.Position.X - elevatorTarget.Position.X, rootPart.Position.Z - elevatorTarget.Position.Z).Magnitude
                                            if checkDist <= 11.0 then
                                                hasVerifiedInElevator = true
                                                if rootPart.Anchored then rootPart.Anchored = false end
                                                print("[ELEVATOR] Terverifikasi aman di dalam Real Elevator! (Duduk santai, kebal pancingan monster)")
                                            end
                                        end
                                    elseif dist > 15.5 then
                                        hasVerifiedInElevator = false
                                    elseif rootPart.Anchored then
                                        rootPart.Anchored = false
                                    end
                                end
                            end
                            task.wait(0.3)
                            continue
                        end

                        inElevatorStandby     = false
                        hasVerifiedInElevator = false
                        ensureExitedElevator()

                        if isThreatened() then
                            performColliderHide("Ter-spot sebelum menuju Generator!")
                            continue
                        end

                        if targetGen and targetCFrame then
                            currentTargetGenerator = targetGen
                            isReadyToTriggerGen    = false

                            moveToPositionGen(targetCFrame, true, targetGen)

                            if abortCurrentMovement or not isMasterFarming or isItemFarmingActive then
                                continue
                            end

                            -- Hitung ulang targetCFrame lever kosong (terutama jika DualGen baru diisi 1 orang)
                            targetCFrame = getGeneratorTargetCFrame(targetGen) or targetCFrame
                            local distToLeverNow = Vector2.new(rootPart.Position.X - targetCFrame.Position.X, rootPart.Position.Z - targetCFrame.Position.Z).Magnitude
                            if distToLeverNow > 8.5 then
                                continue
                            end

                            local isContested  = false
                            local monsterEvade = false
                            local needSync     = isTrinketActive()

                            if needSync then
                                local minD = Config.Teleport.SyncDelayMin
                                local maxD = Config.Teleport.SyncDelayMax
                                local syncDelay = minD + (math.random() * (maxD - minD))

                                print(string.format("[VEE REMOTE] Berdiri di Lever Generator kosong! Menunggu %.2f detik sebelum aktivasi...", syncDelay))

                                local elapsed = 0
                                while elapsed < syncDelay do
                                    if isThreatened() then
                                        monsterEvade = true
                                        break
                                    end
                                    -- Saat mau pakai VeeRemote, wajib pastikan tidak ada 1 pun pemain lain yang mendekat
                                    if isMachineOccupied(targetGen, Config.Teleport.PlayerRadius, true) then
                                        isContested = true
                                        break
                                    end
                                    teleportplr(targetCFrame, false)
                                    task.wait(0.05)
                                    elapsed = elapsed + 0.05
                                end

                                if not monsterEvade and isMachineOccupied(targetGen, Config.Teleport.PlayerRadius, true) then
                                    isContested = true
                                end
                            else
                                if isThreatened() then
                                    monsterEvade = true
                                elseif isMachineOccupied(targetGen, Config.Teleport.PlayerRadius, false) then
                                    isContested = true
                                end
                            end

                            if monsterEvade then
                                performColliderHide("Ter-spot / Monster dekat saat mendarat di Generator!")
                            elseif isContested then
                                print("[SAFETY] Mesin sudah penuh ditempati pemain lain. Batal ekstrak, langsung cari mesin lain!")
                                forceStop()
                                task.wait(0.03)
                            else
                                local hasStartedInteracting = false
                                local instantNext           = false
                                local failTimer             = 0
                                local wasVeeActiveAtStart   = isTrinketActive()
                                isReadyToTriggerGen         = true

                                local invisBlock = targetGen:FindFirstChild("InvisBlock")
                                if invisBlock and invisBlock:IsA("BasePart") then invisBlock.CanCollide = false end

                                while isMasterFarming and farmingSessionId == mySession and targetGen.Parent and not isItemFarmingActive do
                                    if isThreatened() then
                                        forceStop()
                                        performColliderHide("Ter-spot / Monster mendekat saat ekstraksi Generator!")
                                        instantNext = true
                                        break
                                    end

                                    if isItemFarmingActive then
                                        forceStop()
                                        instantNext = true
                                        break
                                    end

                                    local stats = targetGen:FindFirstChild("Stats")
                                    if stats and stats:FindFirstChild("Completed") and stats.Completed.Value then
                                        print("[GENERATOR] Mesin selesai (Completed = true)!")
                                        instantNext = true
                                        break 
                                    end

                                    if wasVeeActiveAtStart and not isTrinketActive() then
                                        print("[VEE REMOTE SUCCESS] Status VeeRemote telah berubah dari 'Active' menjadi 'Inactive'!")
                                        wasVeeActiveAtStart = false
                                        task.wait(0.15)
                                        if stats and stats:FindFirstChild("Completed") and stats.Completed.Value then
                                            instantNext = true
                                            break
                                        end
                                    end

                                    -- Cek apakah mesin penuh (1 orang untuk mesin biasa, 2 orang untuk DualGen, atau >=1 orang jika VeeRemote masih aktif)
                                    if isMachineOccupied(targetGen, Config.Teleport.PlayerRadius, wasVeeActiveAtStart) then
                                        print("[SAFETY] Kapasitas mesin penuh oleh pemain lain. Ngalah & langsung pindah mesin!")
                                        forceStop()
                                        instantNext = true
                                        break
                                    end

                                    local refreshedLeverCF = getGeneratorTargetCFrame(targetGen) or targetCFrame
                                    local flatDistToGen = Vector2.new(rootPart.Position.X - refreshedLeverCF.Position.X, rootPart.Position.Z - refreshedLeverCF.Position.Z).Magnitude
                                    if flatDistToGen > 3.5 then
                                        teleportplr(refreshedLeverCF, false)
                                    end

                                    local currentlyInteracting = isInteractingUI()
                                    if currentlyInteracting then
                                        hasStartedInteracting = true
                                        failTimer = 0 
                                    elseif hasStartedInteracting and not currentlyInteracting then
                                        forceStop()
                                        instantNext = true
                                        break
                                    else
                                        forceTriggerGenerator(targetGen)
                                        failTimer = failTimer + 1
                                        if failTimer % 6 == 0 then
                                            teleportplr(refreshedLeverCF, false)
                                        end
                                        if failTimer >= 35 then
                                            forceStop()
                                            instantNext = true
                                            break
                                        end
                                    end
                                    task.wait(0.08)
                                end

                                isReadyToTriggerGen = false
                                clearAllServerSyncedHolds()
                                restoreNormalGravity()
                                if instantNext then
                                    task.wait(0.02)
                                else
                                    task.wait(Config.Teleport.DelayNext or 0.15)
                                end
                            end

                        else
                            currentTargetGenerator = nil
                            isReadyToTriggerGen    = false
                            local progressText = (curGenUI ~= -1) and (" (" .. curGenUI .. "/" .. totGenUI .. ")") or ""
                            print("[INFO] Mesin belum selesai" .. progressText .. " tapi semua mesin sedang dijaga monster / penuh. Standby di tengah Thick Collider...")
                            moveIntoNearestColliderCenter(Config.Teleport.TweenSpeed, true)
                            task.wait(1.0)
                            setTargetColliderPassable(nil, false)
                        end
                    end
                end
            end
            task.wait(0.04)
        end
    end)
end

-- ==============================================================================
-- [SECTION 10] MASTER WATCHER & FAILSAFE (PEMANTAU UTAMA & PANIC TIME CONTROLLER)
-- ==============================================================================
local hasSweptHeals    = false
local lastGenCount     = -1
local lastProgressTick = tick()

task.spawn(function()
    while task.wait(0.15) do 
        if not isMasterFarming then 
            lastProgressTick = tick()
            continue 
        end

        local curGen, totGen = getMachineProgress()

        if curGen == 0 then
            hasSweptHeals = false 
        end

        if not isItemFarmingActive and not isEmergencyHiding and not inElevatorStandby then
            if curGen ~= lastGenCount then
                lastGenCount = curGen
                lastProgressTick = tick() 
            end

            if tick() - lastProgressTick >= Config.failsafegenerator then
                print("\n==============================================")
                print("[FAILSAFE] Script stuck/bengong selama " .. Config.failsafegenerator .. " detik! Melakukan HARD REBOOT...")
                print("==============================================")

                abortCurrentMovement = true
                forceStop()
                clearAllServerSyncedHolds()
                setTargetColliderPassable(nil, false)
                restoreNormalGravity()
                if rootPart then rootPart.Anchored = false end

                local safePos = getSafePlaceCFrame()
                if safePos then teleportplr(safePos) end

                isMasterFarming = false 
                task.wait(2)

                print("[FAILSAFE] Reboot Selesai. Memulai ulang script...")
                abortCurrentMovement = false
                lastProgressTick = tick() 
                isMasterFarming = true
                startAutoFarming()

                continue
            end
        else
            lastProgressTick = tick() 
        end

        -- Smart Pickup: Coba ambil ulang item heal jika sisa 1 mesin & slot tas kosong
        if curGen > 0 and totGen > 0 and curGen == (totGen - 1) and not hasSweptHeals then
            if getEmptyInventorySlots() > 0 then
                local unblacklistedAny = false
                local map = getMap()
                local itemsFolder = map and map:FindFirstChild("Items")
                if itemsFolder then
                    for _, item in ipairs(itemsFolder:GetChildren()) do
                        if isSecondPriority(item.Name) and item:GetAttribute("BlacklistLimbo") then
                            item:SetAttribute("BlacklistLimbo", nil) 
                            local highlight = item:FindFirstChild("ItemESP")
                            if highlight then highlight.FillColor = Color3.fromRGB(255, 100, 255) end 
                            unblacklistedAny = true
                        end
                    end
                end
                if unblacklistedAny then
                    print("[SMART PICKUP] Sisa 1 Mesin & Tas Kosong! Menghapus Blacklist Healing Item...")
                end
            end
            hasSweptHeals = true
        end

        -- Deteksi Item Baru / Sapu Item Sebelum PanicTime Habis
        local map = getMap()
        local panicReached = isPanicDeadlineReached()

        if map and Config.Pickup.Enable and not inElevatorStandby and not panicReached then
            local stillInElev = isCurrentlyInsideElevator()
            -- [PERBAIKAN PINTAR POIN #2]: Hanya beri jeda 0.8 detik di awal floor JIKA player benar-benar membawa VeeRemote!
            -- Jika tidak membawa VeeRemote, langsung ambil item tanpa tunggu!
            local floorJustStarted = (os.clock() - floorStartTimestamp) < 0.85
                and Config.Teleport.UseVeeRemoteFirst
                and hasVeeRemoteEquipped()

            if not stillInElev and not floorJustStarted then
                local hasSafeValidItems = hasSafePickableItemsInMap()
                local veeRemotePending  = Config.Teleport.UseVeeRemoteFirst and isTrinketActive() and hasUncompletedGeneratorsInMap()

                if hasSafeValidItems and not isItemFarmingActive and not isEmergencyHiding and not isInteractingUI() and not isThreatened() and not veeRemotePending then
                    isItemFarmingActive = true

                    print("\n==============================================")
                    print("[SYSTEM] Mendeteksi Item Aman! Mengambil item...")
                    print("==============================================")

                    forceStop()
                    if rootPart then rootPart.Anchored = false end

                    character = player.Character
                    if not character then 
                        isItemFarmingActive = false 
                        continue 
                    end
                    rootPart = character:FindFirstChild("HumanoidRootPart")
                    if not rootPart then 
                        isItemFarmingActive = false 
                        continue 
                    end

                    local success, err = pcall(function()
                        executePickup() 
                    end)

                    if not success then
                        print("[WARNING] Error saat executePickup: ", err)
                    end

                    isItemFarmingActive = false
                    lastProgressTick = tick() 
                end
            end
        end
    end
end)

-- ==============================================================================
-- [SECTION 11] BARNABY AUTO-PLAY LISTENER (AUTO MINIGAME BARNABY)
-- ==============================================================================
task.spawn(function()
    local Events = ReplicatedStorage:WaitForChild("Events", 10)
    if not Events then return end

    local BarnabyEnterEvent  = Events:WaitForChild("BarnabyEnterEvent", 5)
    local BarnabyTickEvent   = Events:WaitForChild("BarnabyTickEvent", 5)
    local BarnabyCoinEvent   = Events:WaitForChild("BarnabyCoinEvent", 5)
    local BarnabyBootedEvent = Events:WaitForChild("BarnabyBootedEvent", 5)

    if BarnabyEnterEvent then
        BarnabyEnterEvent.OnClientEvent:Connect(function(generator, genId, extraData)
            if not isMasterFarming or not Config.Barnaby.AutoPlay then return end

            _G.IsBarnabyActive = true
            print("[BARNABY AUTO-WIN] Minigame started! Auto-playing...")

            task.spawn(function()
                local pGui = player:FindFirstChild("PlayerGui")
                if pGui and pGui:FindFirstChild("ClientUI") and pGui.ClientUI:FindFirstChild("GameWindow") then
                    pGui.ClientUI.GameWindow.Visible = false
                end

                local ticks = 0
                while _G.IsBarnabyActive and isMasterFarming do
                    if isThreatened() then
                        _G.IsBarnabyActive = false
                        break
                    end

                    if BarnabyTickEvent then BarnabyTickEvent:FireServer(genId, 1) end

                    if ticks % 2 == 0 then
                        if BarnabyCoinEvent then BarnabyCoinEvent:FireServer(genId) end
                    end

                    local stats = generator:FindFirstChild("Stats")
                    if stats then
                        local current     = stats:FindFirstChild("CurrentAmount") and stats.CurrentAmount.Value or 0
                        local required    = stats:FindFirstChild("RequiredAmount") and stats.RequiredAmount.Value or 100
                        local isCompleted = stats:FindFirstChild("Completed") and stats.Completed.Value

                        if current >= required or isCompleted then
                            if BarnabyBootedEvent then BarnabyBootedEvent:FireServer(genId, generator) end
                            _G.IsBarnabyActive = false
                            print("[BARNABY AUTO-WIN] Minigame completed!")
                            break
                        end
                    end

                    local decoding = player.Character and player.Character:FindFirstChild("Decoding")
                    if not decoding then
                        _G.IsBarnabyActive = false
                        break
                    end

                    task.wait(0.5)
                    ticks = ticks + 1
                end
            end)
        end)
    end
end)

-- ==============================================================================
-- [SECTION 12] UI TOGGLE & AUTO-START (TOMBOL UI & EKSEKUSI AWAL)
-- ==============================================================================
local guiContainer = pcall(function() return CoreGui end) and CoreGui or player:WaitForChild("PlayerGui")

local oldToggle = guiContainer:FindFirstChild("MasterFarmToggleUI")
if oldToggle then oldToggle:Destroy() end

local screenGui = Instance.new("ScreenGui")
screenGui.Name         = "MasterFarmToggleUI"
screenGui.ResetOnSpawn = false
screenGui.Parent       = guiContainer

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size             = UDim2.new(0, 150, 0, 40)
toggleBtn.Position         = UDim2.new(0.5, -75, 0, 20)
toggleBtn.Text             = "START FARMING"
toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
toggleBtn.TextColor3       = Color3.fromRGB(255, 255, 255)
toggleBtn.Font             = Enum.Font.SourceSansBold
toggleBtn.TextSize         = 20
toggleBtn.Active           = true
toggleBtn.Draggable        = true
toggleBtn.Parent           = screenGui

toggleBtn.MouseButton1Click:Connect(function()
    if isMasterFarming then
        isMasterFarming        = false
        farmingSessionId       = farmingSessionId + 1
        abortCurrentMovement   = true
        isItemFarmingActive    = false
        isEmergencyHiding      = false
        isPathfinding          = false
        forceCharNoClip        = false
        inElevatorStandby      = false
        hasVerifiedInElevator  = false
        isReadyToTriggerGen    = false
        currentTargetGenerator = nil
        pcall(function() RunService:UnbindFromRenderStep("_MasterFarmWalkSim") end)
        if activeTween then pcall(function() activeTween:Cancel() end); activeTween = nil end
        clearAllServerSyncedHolds()
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        if rootPart then rootPart.Anchored = false end
        forceStop() 
        clearSafeRadiusVisual()
        toggleBtn.Text             = "START FARMING"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.delay(0.3, function() abortCurrentMovement = false end)
    else
        abortCurrentMovement       = false
        isMasterFarming            = true
        toggleBtn.Text             = "STOP FARMING"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        startAutoFarming()
    end
end)

if Config.AutoStartFarming then
    print("[SYSTEM] Auto-Start Enabled. Langsung memulai Farming...")
    isMasterFarming            = true
    toggleBtn.Text             = "STOP FARMING"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    startAutoFarming()
end
