end

-- Menentukan titik tengah kabin Real Elevator (Aman di belakang DoorHitbox)
local function getRealElevatorCFrame()
    local walkY  = (rootPart and rootPart.Position.Y > -50 and rootPart.Position.Y < 200) and rootPart.Position.Y or nil
    local curMap = getMap()

    if cachedRealElevCF and cachedRealElevRoom == curMap then
        return CFrame.new(cachedRealElevCF.X, walkY or cachedRealElevCF.Y, cachedRealElevCF.Z)
    end

    local elevatorsFolder = Workspace:FindFirstChild("Elevators")
    if elevatorsFolder then
        for _, obj in ipairs(elevatorsFolder:GetChildren()) do
            if obj.Name == "Elevator" and obj:IsA("Model") then
                local centerPos  = (obj.PrimaryPart and obj.PrimaryPart.Position) or getModelCenter(obj)
                local doorHitbox = obj:FindFirstChild("DoorHitbox", true)
                if centerPos and doorHitbox then
                    local dPos = doorHitbox:IsA("BasePart") and doorHitbox.Position or doorHitbox:GetPivot().Position
                    local inwardDir = Vector3.new(centerPos.X - dPos.X, 0, centerPos.Z - dPos.Z)
                    if inwardDir.Magnitude > 0.5 then
                        inwardDir = inwardDir.Unit
                        local safeCabinPos = Vector3.new(dPos.X, centerPos.Y, dPos.Z) + (inwardDir * 8.0)
                        cachedRealElevCF   = CFrame.new(safeCabinPos.X, safeCabinPos.Y + 3, safeCabinPos.Z)
                        cachedRealElevRoom = curMap
                        return CFrame.new(safeCabinPos.X, walkY or (safeCabinPos.Y + 3), safeCabinPos.Z)
                    end
                end
                if centerPos then
                    cachedRealElevCF   = CFrame.new(centerPos.X, centerPos.Y + 3, centerPos.Z)
                    cachedRealElevRoom = curMap
                    return CFrame.new(centerPos.X, walkY or (centerPos.Y + 3), centerPos.Z)
                end
            end
        end
        for _, obj in ipairs(elevatorsFolder:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                cachedRealElevCF   = cf
                cachedRealElevRoom = curMap
                return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
            end
        end
    end

    local room = Workspace:FindFirstChild("CurrentRoom")
    if room then
        for _, obj in ipairs(room:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local parentName = string.lower(obj.Parent and obj.Parent.Name or "")
                if not string.find(parentName, "fake") then
                    local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                    cachedRealElevCF   = cf
                    cachedRealElevRoom = curMap
                    return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
                end
            end
        end
    end
    return nil
end

