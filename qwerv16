-- [PERBAIKAN MUTLAK POIN #3]: Menghitung jumlah pemain lain di Generator & Mendukung DualGen (2 Orang)
-- Aturan Khusus:
-- 1. Jika VeeRemote sedang "Active" (atau requireStrictlyEmpty == true): Wajib 0 pemain lain (baik Generator biasa maupun DualGen)!
-- 2. Jika Ekstraksi Normal: Generator biasa penuh jika >= 1 pemain lain; DualGen penuh hanya jika >= 2 pemain lain!
local function countOtherPlayersOnGenerator(generator, radius)
    if not generator or not generator.Parent then return 0 end

    local genCF    = getGeneratorTargetCFrame(generator)
    local promptPt = genCF and genCF.Position
    local okPiv, pivotCF = pcall(function() return generator:GetPivot() end)
    local pivotPt  = (okPiv and pivotCF and pivotCF.Position) or promptPt
    if not promptPt and not pivotPt then return 0 end

    local checkRad    = math.max(radius or Config.Teleport.PlayerRadius or 10, 9.5)
    local otherCount  = 0
    local countedChar = {}

    local function inspectOtherChar(otherChar)
        if not otherChar or otherChar == character or otherChar.Name == player.Name or countedChar[otherChar] then
            return
        end
        local dec = otherChar:FindFirstChild("Decoding")
        if dec and dec.Value == generator then
            countedChar[otherChar] = true
            otherCount = otherCount + 1
            return
        end
        local otherRoot = otherChar:FindFirstChild("HumanoidRootPart") or otherChar.PrimaryPart or otherChar:FindFirstChildWhichIsA("BasePart")
        if otherRoot then
            local oPos = otherRoot.Position
            local nearPrompt = promptPt and (math.abs(oPos.Y - promptPt.Y) <= 12) and (Vector2.new(oPos.X - promptPt.X, oPos.Z - promptPt.Z).Magnitude <= checkRad)
            local nearPivot  = pivotPt and (math.abs(oPos.Y - pivotPt.Y) <= 12) and (Vector2.new(oPos.X - pivotPt.X, oPos.Z - pivotPt.Z).Magnitude <= checkRad)
            if nearPrompt or nearPivot then
                countedChar[otherChar] = true
                otherCount = otherCount + 1
            end
        end
    end

    local inGamePlayers = Workspace:FindFirstChild("InGamePlayers")
    if inGamePlayers then
        for _, otherChar in ipairs(inGamePlayers:GetChildren()) do
            inspectOtherChar(otherChar)
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            inspectOtherChar(plr.Character)
        end
    end

    return otherCount
end

local function isMachineOccupied(generator, radius, requireStrictlyEmpty)
    if not generator or not generator.Parent then return false end

    local otherPlayersCount = countOtherPlayersOnGenerator(generator, radius)

    -- Jika VeeRemote sedang "Active", WAJIB cari mesin yang benar-benar 100% kosong (0 pemain lain)!
    local veeActiveNow = Config.Teleport.UseVeeRemoteFirst and isTrinketActive()
    if requireStrictlyEmpty or veeActiveNow then
        return otherPlayersCount >= 1
    end

    -- Jika ini DualGen (bisa 2 orang), baru dianggap penuh kalau sudah ada >= 2 pemain lain!
    if isDualGenerator(generator) then
        return otherPlayersCount >= 2
    end

    -- Generator biasa dianggap penuh kalau ada >= 1 pemain lain
    return otherPlayersCount >= 1
end

local function findAlternativeSafeGenerator(excludeNearPos)
    local map = getMap()
    local genFolder = map and map:FindFirstChild("Generators")
    if not genFolder or not rootPart then return nil end

    local genSafeRad = Config.Teleport.GeneratorSafeRadius or 18
    local now        = os.clock()

    for _, gen in ipairs(genFolder:GetChildren()) do
        if gen:IsA("Model") then
            local stats     = gen:FindFirstChild("Stats")
            local completed = stats and stats:FindFirstChild("Completed") and stats.Completed.Value
            local connie    = stats and stats:FindFirstChild("Connie") and stats.Connie.Value
            local campedCd  = gen:GetAttribute("MonsterCampedUntil") or 0

            if not completed and not connie and now >= campedCd and not isMachineOccupied(gen, Config.Teleport.PlayerRadius) then
                local genCF = getGeneratorTargetCFrame(gen)
                if genCF then
                    local gPos = genCF.Position
                    local distFromHide = excludeNearPos and Vector2.new(gPos.X - excludeNearPos.X, gPos.Z - excludeNearPos.Z).Magnitude or 999
                    if distFromHide > 28 and not isThreatened(gPos, genSafeRad) and not isNearLethalMonster(gPos, 5) then
