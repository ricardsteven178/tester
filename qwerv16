-- Mengumpulkan daftar posisi karakter pemain lain di dekat generator tertentu
local function getOtherPlayerPositionsNearGen(gen, maxRad)
    local positions = {}
    if not gen then return positions end
    local okPiv, pivCF = pcall(function() return gen:GetPivot() end)
    local centerPt = okPiv and pivCF and pivCF.Position
    if not centerPt then return positions end

    local checkRad = maxRad or 14.0
    local seenChar = {}

    local function checkChar(otherChar)
        if not otherChar or otherChar == character or otherChar.Name == player.Name or seenChar[otherChar] then
            return
        end
        seenChar[otherChar] = true
        local oRoot = otherChar:FindFirstChild("HumanoidRootPart") or otherChar.PrimaryPart or otherChar:FindFirstChildWhichIsA("BasePart")
        if oRoot then
            local dec = otherChar:FindFirstChild("Decoding")
            if (dec and dec.Value == gen) or Vector2.new(oRoot.Position.X - centerPt.X, oRoot.Position.Z - centerPt.Z).Magnitude <= checkRad then
                table.insert(positions, oRoot.Position)
            end
        end
    end

    local inGamePlayers = Workspace:FindFirstChild("InGamePlayers")
    if inGamePlayers then
        for _, c in ipairs(inGamePlayers:GetChildren()) do checkChar(c) end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then checkChar(plr.Character) end
    end

    return positions
end

-- Menentukan titik berdiri tepat di Lever / ProximityPrompt Mesin (Mendukung pemilihan lever kosong pada DualGen!)
local function getGeneratorTargetCFrame(gen)
    if not gen then return nil end

    -- Kumpulkan semua BasePart tempat ProximityPrompt menempel (Pada DualGen ada 2 lever/prompt!)
    local promptParts = {}
    local seenPart    = {}
    for _, desc in ipairs(gen:GetDescendants()) do
        if desc:IsA("ProximityPrompt") then
            local pp = desc:FindFirstAncestorWhichIsA("BasePart")
            if pp and not seenPart[pp] then
                seenPart[pp] = true
                table.insert(promptParts, pp)
            end
        end
    end

    local promptPart = nil
    if #promptParts > 1 then
        -- Jika ini DualGen (memiliki >= 2 lever) dan ada 1 pemain lain di sana, pilih lever yang PALING JAUH dari pemain lain tersebut!
        local otherPositions = getOtherPlayerPositionsNearGen(gen, 14.0)
        if #otherPositions > 0 then
            local bestDist = -1
            for _, pp in ipairs(promptParts) do
                local minDistToOther = math.huge
                for _, oPos in ipairs(otherPositions) do
                    local d = Vector2.new(pp.Position.X - oPos.X, pp.Position.Z - oPos.Z).Magnitude
                    if d < minDistToOther then minDistToOther = d end
                end
                if minDistToOther > bestDist then
                    bestDist   = minDistToOther
                    promptPart = pp
                end
            end
        else
            -- Jika kosong semua, pilih lever terdekat dari posisi kita
            local minDistToMe = math.huge
            for _, pp in ipairs(promptParts) do
                local d = rootPart and (pp.Position - rootPart.Position).Magnitude or 0
                if d < minDistToMe then
                    minDistToMe = d
                    promptPart  = pp
                end
            end
        end
    else
        promptPart = promptParts[1]
    end

    if not promptPart then
        local p = gen:FindFirstChild("Prompt", true)
        if p and p:IsA("BasePart") then
            promptPart = p
        elseif p and p:IsA("Model") then
            promptPart = p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
        end
    end

    local targetPart = promptPart
        or gen:FindFirstChild("Origin")
        or gen.PrimaryPart
        or gen:FindFirstChildWhichIsA("BasePart", true)

    if targetPart then
        local gPos   = targetPart:IsA("BasePart") and targetPart.Position or gen:GetPivot().Position
        local standY = getTargetStandingY(gPos.Y, false) + (Config.Teleport.UndergroundOffset or 0)

        local centerRef = gen:FindFirstChild("InvisBlock") or gen:FindFirstChild("BaseMachine")
        if promptPart and centerRef and centerRef:IsA("BasePart") then
            local outVec = Vector3.new(gPos.X - centerRef.Position.X, 0, gPos.Z - centerRef.Position.Z)
            if outVec.Magnitude > 0.2 then
                local leverFrontPos = gPos + (outVec.Unit * 1.1)
                return CFrame.new(leverFrontPos.X, standY, leverFrontPos.Z)
            end
        end

        return CFrame.new(gPos.X, standY, gPos.Z)
    end
    return nil
end

local function getMachineProgress()
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        local specGui  = pGui:FindFirstChild("SpectatorGui")
        local info     = specGui and specGui:FindFirstChild("InfoFrame")
        local genFrame = info and info:FindFirstChild("GeneratorFrame")
        local msg      = genFrame and genFrame:FindFirstChild("Message")
        if msg and msg:IsA("TextLabel") then
            local cur, tot = string.match(msg.Text, "Machines Completed: (%d+)/(%d+)")
            if cur and tot then
                return tonumber(cur), tonumber(tot)
            end
        end
        for _, gui in ipairs(pGui:GetChildren()) do
            local topBar = gui:FindFirstChild("TopBar", true)
            local gf     = (topBar and topBar:FindFirstChild("GeneratorFrame")) or gui:FindFirstChild("GeneratorFrame", true)
            local m      = gf and gf:FindFirstChild("Message")
            if m and m:IsA("TextLabel") then
                local cur, tot = string.match(m.Text, "Machines Completed: (%d+)/(%d+)")
                if cur and tot then
                    return tonumber(cur), tonumber(tot)
                end
            end
        end
    end
    return -1, -1
end

-- [FITUR BARU POIN #1]: Membaca sisa detik dari 'Quickly! Elevator leaves in X seconds!'
-- Path utama: Players.LocalPlayer.PlayerGui.ScreenGui.Menu.TopBar.Message
local function getElevatorCountdownSeconds()
    local pGui = player:FindFirstChild("PlayerGui")
    if not pGui then return nil end

    -- 1. Cek langsung di path spesifik: ScreenGui.Menu.TopBar.Message
    local screenGui = pGui:FindFirstChild("ScreenGui")
    local menu      = screenGui and screenGui:FindFirstChild("Menu")
    local topBar    = menu and menu:FindFirstChild("TopBar")
    local msgLabel  = topBar and topBar:FindFirstChild("Message")

    if msgLabel and msgLabel:IsA("TextLabel") and msgLabel.Visible then
        local sec = string.match(msgLabel.Text, "Elevator leaves in (%d+)")
            or string.match(string.lower(msgLabel.Text), "leaves in (%d+)")
        if sec then
            return tonumber(sec)
        end
    end

    -- 2. Fallback scan di TopBar / SpectatorGui jika struktur UI bergeser
    for _, gui in ipairs(pGui:GetChildren()) do
        local tb = gui:FindFirstChild("TopBar", true) or gui:FindFirstChild("InfoFrame", true)
        if tb then
            for _, d in ipairs(tb:GetDescendants()) do
                if d:IsA("TextLabel") and d.Visible then
                    local sec = string.match(d.Text, "Elevator leaves in (%d+)")
                        or string.match(string.lower(d.Text), "leaves in (%d+)")
                    if sec then
                        return tonumber(sec)
                    end
                end
            end
        end
    end

    return nil
end

