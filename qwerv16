            prompt:InputHoldEnd()
        end)
    end
end

-- Memicu ProximityPrompt pada mesin (Jika DualGen ada 2 prompt, utamakan prompt yang paling dekat dengan kita!)
local function forceTriggerGenerator(generator)
    local bestPrompt = nil
    local minDist    = math.huge
    for _, descendant in ipairs(generator:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Enabled then
            local pPart = descendant:FindFirstAncestorWhichIsA("BasePart")
            local d = (pPart and rootPart) and (pPart.Position - rootPart.Position).Magnitude or 0
            if d < minDist then
                minDist    = d
                bestPrompt = descendant
            end
        end
    end
    if bestPrompt then
        interactWithPrompt(bestPrompt)
        return true
    end
    return false
end

