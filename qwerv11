local function clearPathVisuals()
    for _, v in ipairs(pathVisuals) do pcall(function() v:Destroy() end) end
    pathVisuals = {}
end

local function clearAllServerSyncedHolds()
    for _, c in ipairs(activeHoldConns) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(activeHoldConns)
end

-- Server-Synced Micro-Jitter Hold (±0.03 studs) agar hitbox karakter benar-benar sinkron di server
local function startServerSyncedHold(getTargetPosFn)
    clearAllServerSyncedHolds()
    if rootPart then rootPart.Anchored = false end
    Workspace.Gravity = 0
    local tickCounter = 0
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not rootPart or abortCurrentMovement or not isMasterFarming then
            if conn then conn:Disconnect() end
            return
        end
        local holdPos = getTargetPosFn()
        if not holdPos then return end
        if (rootPart.Position - holdPos).Magnitude <= 3.8 then
            tickCounter = tickCounter + 1
            local jitterX = (tickCounter % 2 == 0) and 0.03 or -0.03
            local jitterZ = (tickCounter % 4 < 2) and 0.03 or -0.03
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = CFrame.new(holdPos.X + jitterX, holdPos.Y, holdPos.Z + jitterZ)
        end
    end)
    table.insert(activeHoldConns, conn)
    return conn
end

local function recordFailedRollbackZone(pos)
    if not pos then return end
    for _, p in ipairs(failedRollbackZones) do
        if (p - pos).Magnitude < 4.0 then return end
    end
    table.insert(failedRollbackZones, pos)
    if #failedRollbackZones > 12 then
        table.remove(failedRollbackZones, 1)
    end
end

local function teleportplr(cf, keepZeroGravity)
    if not rootPart then return end
    Workspace.Gravity = 0
    rootPart.AssemblyLinearVelocity  = Vector3.zero
    rootPart.AssemblyAngularVelocity = Vector3.zero
    rootPart.CFrame = cf
    if character then character:PivotTo(cf) end
    if not keepZeroGravity and not isPathfinding and not isEmergencyHiding then
        restoreNormalGravity()
    end
end

-- Dual-Speed Walk Simulation (3.50x Open Air / 1.05x saat mendekati atau menembus Obstacle)
local function teleportTween(cf, speed, ignoreThreat, forceSnapEnd, customCancelFn)
    if not rootPart or not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    rootPart.Anchored = false

    local targetPos    = cf.Position
    local startPos     = rootPart.Position
    local verticalDiff = math.abs(targetPos.Y - startPos.Y)

    local baseSpd    = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
    local origWalk   = (hum and hum.WalkSpeed > 0) and hum.WalkSpeed or 16
    local openMult   = speed or Config.Teleport.TweenSpeed or 3.50
    local noclipMult = Config.Teleport.NoClipTweenSpeed or 1.05

    local _, segLayers      = analyzeSegmentLayers(startPos, targetPos, nil, 1.8)
    local isSlopedStageMove = (verticalDiff > 1.8)
    local isVerticalMove    = isSlopedStageMove

    local effectiveMult = (isSlopedStageMove and segLayers > 0) and math.min(openMult, noclipMult) or openMult
    local moveSpd       = baseSpd * effectiveMult
    local cancelled     = false

    local curMap = getMap()
    local monstersFolder = curMap and curMap:FindFirstChild("Monsters")
    local sensorParams = OverlapParams.new()
    sensorParams.FilterType = Enum.RaycastFilterType.Exclude
    sensorParams.FilterDescendantsInstances = monstersFolder and { character, monstersFolder } or { character }

    local function isTouchingOrApproachingObstacle(curPos, dirUnit)
        local behindPos = curPos - (dirUnit * 2.5)
        local midAhead  = curPos + (dirUnit * 3.0)
        local farAhead  = curPos + (dirUnit * 5.8)

        for _, col in ipairs(getNoClipColliders()) do
            if col and col.Parent then
                if isPointInsideExpandedBox(curPos, col, 4.2, 2.5)
                   or isPointInsideExpandedBox(behindPos, col, 3.2, 2.5)
                   or isPointInsideExpandedBox(midAhead, col, 4.2, 2.5)
                   or isPointInsideExpandedBox(farAhead, col, 3.8, 2.5) then
                    return true
                end
            end
        end

        local ok, parts = pcall(function()
            return Workspace:GetPartBoundsInBox(CFrame.new(curPos + (dirUnit * 2.2)), Vector3.new(7.2, 3.0, 7.2), sensorParams)
        end)
        if ok and parts then
            for _, p in ipairs(parts) do
                if p and p:IsA("BasePart") and not isFloorPart(p) then
                    local pn = p.Name
                    if (pn ~= "_NoClipESP" and pn ~= "_LineESPBeam" and pn ~= "_PFVirtualBlocker" and p.Transparency < 0.98)
                       or isColliderName(pn) or pn == "InvisBlock" then
                        return true
                    end
                end
            end
        end
        return false
    end

    forceCharNoClip = true
    if Config.NoClip.Enable then applyNoClipState() end

    if not isVerticalMove and hum then
        restoreNormalGravity()
        hum.PlatformStand = false
        hum.Sit           = false
        if hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.None then
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end

        local currentDir   = Vector3.zero
        local stepBindName = "_MasterFarmWalkSim"
        pcall(function() RunService:UnbindFromRenderStep(stepBindName) end)

        RunService:BindToRenderStep(stepBindName, Enum.RenderPriority.Character.Value + 10, function()
            if rootPart and hum and hum.Parent and currentDir.Magnitude > 0.01 then
                hum.WalkSpeed = moveSpd
                hum:Move(currentDir, false)
            end
        end)

        local totalDist          = Vector2.new(targetPos.X - startPos.X, targetPos.Z - startPos.Z).Magnitude
        local minSpdEst          = baseSpd * math.min(openMult, noclipMult)
        local timeoutClock       = os.clock() + math.max((totalDist / math.max(minSpdEst, 5)) * 3.0, 4.0)
        local lastPos            = rootPart.Position
        local stuckTimer         = 0
        local lastObstacleClock  = 0
        local lastSensorCheck    = 0
        local cachedNearObstacle = false

        while rootPart and hum and hum.Parent and os.clock() < timeoutClock and isMasterFarming do
            if abortCurrentMovement or (not ignoreThreat and isThreatened()) or (customCancelFn and customCancelFn()) then
                cancelled = true
                break
            end

            local curPos   = rootPart.Position
            local flatDiff = Vector3.new(targetPos.X - curPos.X, 0, targetPos.Z - curPos.Z)
            local dist     = flatDiff.Magnitude

            if dist <= 1.6 then
                break
            end

            currentDir = flatDiff.Unit

            -- [PERBAIKAN POIN #2]: Saat lari darurat ke Collider (ignoreThreat == true),
            -- JANGAN mengerem gara-gara mesin Generator atau meja Item yang baru ditinggalkan!
            -- Langsung SPRINT 3.50x meninggalkan monster dan hanya rem ke 1.05x saat jarak <= 4.2 studs dari titik tengah collider!
            if ignoreThreat then
                if dist <= 4.2 then
                    moveSpd = baseSpd * noclipMult
                else
                    moveSpd = baseSpd * openMult
                end
            else
                local now = os.clock()
                if (now - lastSensorCheck) >= 0.07 then
                    lastSensorCheck    = now
                    cachedNearObstacle = isTouchingOrApproachingObstacle(curPos, currentDir)
                    if cachedNearObstacle then
                        lastObstacleClock = now
                    end
                end

                if cachedNearObstacle or (now - lastObstacleClock) < 0.28 or dist <= 4.5 then
                    moveSpd = baseSpd * noclipMult
                else
                    moveSpd = baseSpd * openMult
                end
            end

            hum.WalkSpeed = moveSpd
            hum:Move(currentDir, false)

            local dt = RunService.Heartbeat:Wait()
            if not rootPart then break end

            if (rootPart.Position - lastPos).Magnitude < 0.08 then
                stuckTimer = stuckTimer + dt
                if stuckTimer > 0.25 then
                    applyNoClipState()
                    stuckTimer = 0
                end
            else
                stuckTimer = 0
                lastPos = rootPart.Position
            end
        end

        currentDir = Vector3.zero
        pcall(function() RunService:UnbindFromRenderStep(stepBindName) end)
        if hum and hum.Parent then
            hum:Move(Vector3.zero, false)
            hum.WalkSpeed = origWalk
        end
    else
        Workspace.Gravity = 0
        local dist = (startPos - targetPos).Magnitude
        local dur  = math.max(dist / math.max(moveSpd, 1), 0.001)
        local tw   = TweenService:Create(rootPart, TweenInfo.new(dur, Enum.EasingStyle.Linear), { CFrame = cf })
        activeTween = tw
        tw:Play()

        local done = false
        tw.Completed:Connect(function(playbackState)
            if playbackState == Enum.PlaybackState.Completed then done = true end
        end)

        while not done and isMasterFarming do
            if abortCurrentMovement or (not ignoreThreat and isThreatened()) or (customCancelFn and customCancelFn()) then
                tw:Cancel()
                cancelled = true
                break
            end
            task.wait(0.015)
        end

        if not cancelled and rootPart and (rootPart.Position - targetPos).Magnitude <= 4.0 then
            rootPart.CFrame = cf
        end
        if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end
        if activeTween == tw then activeTween = nil end
    end

    if not Config.NoClip.Enable and not isEmergencyHiding then
        forceCharNoClip = false
    end
    if not isPathfinding and not isEmergencyHiding then
        restoreNormalGravity()
    end

    return cancelled
end

local function moveIntoNearestColliderCenter(speed, ignoreThreat, excludedCol)
    if not rootPart then return nil, nil end
    rootPart.Anchored = false
    local startPos  = clampPositionAboveFloor(rootPart.Position)
    local hideRoute = getNearestSafeColliderRoute(startPos, excludedCol)
    local targetCol = hideRoute.targetCol

    setTargetColliderPassable(targetCol, true)
    local moveSpd = speed or math.max(Config.Teleport.HideEnterSpeed or 3.50, 2.0)

    for i, wpPos in ipairs(hideRoute.waypoints) do
        if abortCurrentMovement or not isMasterFarming then break end
        local isLast = (i == #hideRoute.waypoints)
        local cancelled = teleportTween(CFrame.new(wpPos), moveSpd, ignoreThreat, isLast)
        if cancelled and not ignoreThreat then
            return nil, hideRoute
        end
    end

    if rootPart and hideRoute.centerPos and not abortCurrentMovement then
        if (rootPart.Position - hideRoute.centerPos).Magnitude <= 4.2 then
            rootPart.CFrame = CFrame.new(hideRoute.centerPos)
            if character then character:PivotTo(CFrame.new(hideRoute.centerPos)) end
        end
    end
    return hideRoute.centerPos, hideRoute
end

-- [HIRARKI TERTINGGI] Pause Task -> Force Stop Mesin Instan -> Sprint 3.50x ke Tengah Thick Collider -> Tunggu ResumeSafeDelay
performColliderHide = function(reasonText)
    if isEmergencyHiding or not rootPart then return false end
    isEmergencyHiding = true
    print("\n[EMERGENCY SPOT - HIRARKI TERTINGGI] " .. (reasonText or "Ter-spot Monster!") .. " Force-Close & Sprint ke tengah Thick Collider...")
    
    -- Putus semua kunci ekstraksi & pickup detik ini juga!
    clearAllServerSyncedHolds()
    forceStop()

    if not Config.Teleport.HideInColliderOnSpot then
        local safePos = getSafePlaceCFrame()
        if safePos then teleportplr(safePos) end
        task.wait(Config.Teleport.ResumeSafeDelay or 4.0)
        isEmergencyHiding = false
        return true
    end

    local hideSpeed = math.max(Config.Teleport.HideEnterSpeed or 3.50, 2.5)
    local centerPos, hideRoute = moveIntoNearestColliderCenter(hideSpeed, true)
    if abortCurrentMovement or not isMasterFarming then
        isEmergencyHiding = false
        clearAllServerSyncedHolds()
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    local targetCol    = hideRoute and hideRoute.targetCol
    local pName        = (targetCol and targetCol.Parent and targetCol.Parent.Name) or (targetCol and targetCol.Name) or "ThickCollider"
    local finalHidePos = (rootPart and centerPos and (rootPart.Position - centerPos).Magnitude <= 4.5) and rootPart.Position or (centerPos or rootPart.Position)

    local hidePlat = Instance.new("Part")
    hidePlat.Size         = Vector3.new(10, 1, 10)
    hidePlat.Anchored     = true
    hidePlat.CanCollide   = true
    hidePlat.Transparency = 1
    hidePlat.CFrame       = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
    hidePlat.Parent       = Workspace

    local syncConn = startServerSyncedHold(function() return finalHidePos end)
    local syncRetryCount = 0

    local function verifyAndFixRealHidePosition()
        if not rootPart or abortCurrentMovement or not isMasterFarming or syncRetryCount >= 1 then return end
        local desyncDist = (rootPart.Position - finalHidePos).Magnitude
        if desyncDist > 4.5 then
            syncRetryCount = syncRetryCount + 1
            if syncConn then syncConn:Disconnect(); syncConn = nil end
            setTargetColliderPassable(targetCol, true)
            teleportTween(CFrame.new(finalHidePos), hideSpeed, true, true)
            if rootPart and not abortCurrentMovement then
                finalHidePos = rootPart.Position
                syncConn = startServerSyncedHold(function() return finalHidePos end)
            end
        end
    end

    local maxHideWait = Config.Teleport.MaxHideWaitTime or 22.0
    local safeDelay   = Config.Teleport.ResumeSafeDelay or 4.0

    print(string.format("[EMERGENCY HIDE] Bersembunyi di tengah %s. Menunggu Simbol Mata hilang + %.1f detik aman...", pName, safeDelay))
    local hideStartClock = os.clock()
    while isThreatened() and (os.clock() - hideStartClock) < maxHideWait and not abortCurrentMovement and isMasterFarming do
        verifyAndFixRealHidePosition()
        if hidePlat and hidePlat.Parent and rootPart then
            hidePlat.CFrame = CFrame.new(finalHidePos.X, finalHidePos.Y - 3, finalHidePos.Z)
        end
        task.wait(0.15)
    end

    local safeStartClock = os.clock()
    local totalTimeout   = maxHideWait + safeDelay + 4.0
    while (os.clock() - safeStartClock) < safeDelay and (os.clock() - hideStartClock) < totalTimeout and not abortCurrentMovement and isMasterFarming do
        if isThreatened() then
            safeStartClock = os.clock()
        end
        task.wait(0.15)
    end

    clearAllServerSyncedHolds()
    if hidePlat and hidePlat.Parent then hidePlat:Destroy() end
    if rootPart then rootPart.Anchored = false end

    if abortCurrentMovement or not isMasterFarming then
        isEmergencyHiding = false
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if hideRoute and hideRoute.exitPos then
        teleportTween(CFrame.new(hideRoute.exitPos), Config.Teleport.TweenSpeed, true, true)
    end
    setTargetColliderPassable(nil, false)
    restoreNormalGravity()
    isEmergencyHiding = false
    print("[EMERGENCY CLEAR] Simbol Mata hilang & area aman! Melanjutkan task...\n")
    task.wait(0.1)
    return true
end

-- NavMesh Pathfinding dengan Prioritas 1-Layer
pathfindTween = function(targetCF, _attempt, skipFirstLayerTry, customCancelFn)
    if isPathfinding or not rootPart then return false end
    isPathfinding = true
    clearPathVisuals()
    updateColliderCaches()

    local walkY         = getSafeWalkY(rootPart.Position.Y)
    local targetY       = getTargetStandingY(targetCF.Position.Y, true)
    local startFlat     = Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z)
    local computeTarget = Vector3.new(targetCF.Position.X, targetY, targetCF.Position.Z)
    local attempt       = _attempt or 0

    if attempt == 0 and not skipFirstLayerTry then
        local goalCol = nil
        for _, col in ipairs(cachedAllCols) do
            if col and col.Parent and isPointInsideExpandedBox(computeTarget, col, 1.5, 2.0) then
                goalCol = col
                break
            end
        end

        local okDirect, layerCount, hitCol = analyzeSegmentLayers(startFlat, computeTarget, goalCol, 1.35)
        if okDirect and layerCount <= 1 then
            if hitCol then setTargetColliderPassable(hitCol, true) end
            if goalCol then setTargetColliderPassable(goalCol, true) end
            forceCharNoClip = true

            local isInterrupted = teleportTween(CFrame.new(computeTarget), Config.Teleport.TweenSpeed, false, true, customCancelFn)
            setTargetColliderPassable(nil, false)

            if isInterrupted then
                if customCancelFn and customCancelFn() then
                    isPathfinding = false
                    restoreNormalGravity()
                    return true
                end
                if isThreatened() then
                    restoreNormalGravity()
                    isPathfinding = false
                    local resumed = performColliderHide("Ter-spot saat jalan lurus 1-Layer!")
                    if resumed and not abortCurrentMovement and isMasterFarming then
                        return pathfindTween(targetCF, 1, true, customCancelFn)
                    end
                    return true
                end
            end

            task.wait(0.05)
            if rootPart and (rootPart.Position - computeTarget).Magnitude <= 5.5 then
                isPathfinding = false
                restoreNormalGravity()
                return false
            end
        end
    end

    local currentParams = (attempt >= 2) and AGENT_PARAMS_LASTRESORT
                       or (attempt == 1) and AGENT_PARAMS_FALLBACK
                       or AGENT_PARAMS

    for _, col in ipairs(cachedAllCols) do
        if col and col:IsA("BasePart") then col.CanCollide = true end
    end

    local tempVirtualBlockers = {}
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        local looseSize = (Config.Teleport.LooseRadius or 10) * 1.9
        for _, m in pairs(monstersFolder:GetChildren()) do
            if m:IsA("Model") and isLooseMonsterName(m.Name) then
                local mp = getMonsterPart(m)
                if mp and rootPart and (mp.Position - rootPart.Position).Magnitude > 3.0 and (mp.Position - computeTarget).Magnitude > 4.0 then
                    local mb = Instance.new("Part")
                    mb.Name         = "_PFVirtualBlocker"
                    mb.Size         = Vector3.new(looseSize, 12, looseSize)
                    mb.Position     = mp.Position
                    mb.Anchored     = true
                    mb.CanCollide   = true
                    mb.Transparency = 1
                    mb.Parent       = Workspace
                    table.insert(tempVirtualBlockers, mb)
                end
            end
        end
    end

    local path = PathfindingService:CreatePath(currentParams)
    local ok   = pcall(function() path:ComputeAsync(startFlat, computeTarget) end)

    for _, vb in ipairs(tempVirtualBlockers) do
        pcall(function() vb:Destroy() end)
    end

    if Config.NoClip.Enable then
        applyNoClipState()
    else
        for _, col in ipairs(cachedAllCols) do
            if col and col:IsA("BasePart") then col.CanCollide = true end
        end
    end

    if not ok or path.Status ~= Enum.PathStatus.Success then
        if attempt < 2 then
            isPathfinding = false
            task.wait(0.05)
            return pathfindTween(targetCF, attempt + 1, true, customCancelFn)
        else
            forceCharNoClip = true
            local cancelled = teleportTween(CFrame.new(computeTarget), Config.Teleport.TweenSpeed, false, true, customCancelFn)
            forceCharNoClip = false
            isPathfinding = false
            restoreNormalGravity()
            return cancelled
        end
    end

    local rawWaypoints = path:GetWaypoints()
    if #rawWaypoints == 0 then
        isPathfinding = false
        local cancelled = teleportTween(CFrame.new(computeTarget), Config.Teleport.TweenSpeed, false, true, customCancelFn)
        restoreNormalGravity()
        return cancelled
    end

    local flatWaypoints = {}
    for i = 1, #rawWaypoints do
        local rawY     = rawWaypoints[i].Position.Y + 3.0
        local wpHeight = (math.abs(rawY - walkY) <= 1.8) and walkY or rawY
        table.insert(flatWaypoints, Vector3.new(rawWaypoints[i].Position.X, wpHeight, rawWaypoints[i].Position.Z))
    end

    local optimizedWps = {}
    local curIdx = 1
    while curIdx < #flatWaypoints do
        local nextIdx    = curIdx + 1
        local maxAllowed = (attempt == 0) and 1 or 0
        for j = #flatWaypoints, curIdx + 2, -1 do
            local okSeg, segLayers = analyzeSegmentLayers(flatWaypoints[curIdx], flatWaypoints[j], nil, 1.4)
            if okSeg and segLayers <= maxAllowed then
                nextIdx = j
                break
            end
        end
        table.insert(optimizedWps, flatWaypoints[nextIdx])
        curIdx = nextIdx
    end

    for _, wpPos in ipairs(optimizedWps) do
        if abortCurrentMovement or not isMasterFarming then break end
        local wpCF = CFrame.new(wpPos.X, wpPos.Y, wpPos.Z)
        local isInterrupted = teleportTween(wpCF, Config.Teleport.TweenSpeed, false, true, customCancelFn)
        if isInterrupted then
            if customCancelFn and customCancelFn() then
                isPathfinding = false
                restoreNormalGravity()
                return true
            end
            if isThreatened() then
                restoreNormalGravity()
                isPathfinding = false
                local resumed = performColliderHide("Ter-spot di tengah rute NavMesh!")
                if resumed and not abortCurrentMovement and isMasterFarming and attempt < 2 then
                    task.wait(0.1)
                    return pathfindTween(targetCF, attempt + 1, true, customCancelFn)
                end
                return true
            end
            if abortCurrentMovement then break end
        end
    end

    isPathfinding = false
    restoreNormalGravity()
    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end
    return false
end

-- [PERBAIKAN MUTLAK POIN #1]: Auto-Exit Pintu Elevator Lurus ke Depan (Anti-Belok ke Tembok Samping Lift!)
local function ensureExitedElevator()
    if not Config.Teleport.AutoExitElevator or not rootPart then return end

    local curMap = getMap()
    if curMap and lastExitedFloorMap == curMap then
        -- Cek cepat apakah masih di dalam kotak lift
        local elevatorsFolder = Workspace:FindFirstChild("Elevators")
        local stillInside = false
        if elevatorsFolder then
            for _, el in ipairs(elevatorsFolder:GetChildren()) do
                if el.Name == "Elevator" and el:IsA("Model") then
                    local cPos = (el.PrimaryPart and el.PrimaryPart.Position) or getModelCenter(el)
                    if cPos and Vector2.new(rootPart.Position.X - cPos.X, rootPart.Position.Z - cPos.Z).Magnitude <= 14.5 then
                        stillInside = true
                        break
                    end
                end
            end
        end
        if not stillInside then return end
    end

    local elevatorsFolder = Workspace:FindFirstChild("Elevators")
    if not elevatorsFolder then return end

    local insideElevatorModel = nil
    local elevCenterPos       = nil

    for _, el in ipairs(elevatorsFolder:GetChildren()) do
        if el.Name == "Elevator" and el:IsA("Model") then
            local cPos = (el.PrimaryPart and el.PrimaryPart.Position) or getModelCenter(el)
            if cPos then
                local flatDist = Vector2.new(rootPart.Position.X - cPos.X, rootPart.Position.Z - cPos.Z).Magnitude
                if flatDist <= 16.5 and math.abs(rootPart.Position.Y - cPos.Y) <= 15 then
                    insideElevatorModel = el
                    elevCenterPos       = cPos
                    break
                end
            end
        end
    end

    if not insideElevatorModel or not elevCenterPos then return end

    -- Tunggu sampai Generators di floor baru benar-benar selesai di-generate
    local waitGen = 0
    while isMasterFarming and not abortCurrentMovement and waitGen < 5.0 do
        local m = getMap()
        local gFolder = m and m:FindFirstChild("Generators")
        if gFolder and #gFolder:GetChildren() > 0 then
            curMap = m
            break
        end
        task.wait(0.15)
        waitGen = waitGen + 0.15
    end

    print("[ELEVATOR EXIT] Karakter di dalam Lift! Berjalan LURUS keluar pintu depan Lift terlebih dahulu...")
    local walkY = getSafeWalkY(rootPart.Position.Y)

    -- Hitung arah lurus pintu depan lift berdasarkan arah menuju titik tengah seluruh Map (dikunci ke sumbu mata angin +X, -X, +Z, -Z)
    -- TIDAK BOLEH memakai posisi item (goalPos) atau panel pintu geser samping agar tidak menabrak tembok kanan/kiri lift!
    local mapCenter = (curMap and getModelCenter(curMap)) or (elevCenterPos + Vector3.new(0, 0, 40))
    local rawVec    = Vector3.new(mapCenter.X - elevCenterPos.X, 0, mapCenter.Z - elevCenterPos.Z)
    local exitDir
    if math.abs(rawVec.X) > math.abs(rawVec.Z) then
        exitDir = Vector3.new(rawVec.X >= 0 and 1 or -1, 0, 0)
    else
        exitDir = Vector3.new(0, 0, rawVec.Z >= 0 and 1 or -1)
    end

    -- 1. Luruskan karakter ke garis tengah pintu lift dulu agar bahu karakter tidak nyangkut kusen pintu samping
    local centerDoorWay = Vector3.new(elevCenterPos.X, walkY, elevCenterPos.Z) + (exitDir * 3.0)
    local doorThreshold = Vector3.new(elevCenterPos.X, walkY, elevCenterPos.Z) + (exitDir * 11.0)
    local outsidePoint  = Vector3.new(elevCenterPos.X, walkY, elevCenterPos.Z) + (exitDir * 24.0)

    teleportTween(CFrame.new(centerDoorWay), Config.Teleport.TweenSpeed, false, true)
    if not abortCurrentMovement and isMasterFarming then
        teleportTween(CFrame.new(doorThreshold), Config.Teleport.TweenSpeed, false, true)
    end
    if not abortCurrentMovement and isMasterFarming then
        teleportTween(CFrame.new(outsidePoint), Config.Teleport.TweenSpeed, false, true)
    end

    if rootPart and Vector2.new(rootPart.Position.X - elevCenterPos.X, rootPart.Position.Z - elevCenterPos.Z).Magnitude > 16.5 then
        lastExitedFloorMap = curMap
        print("[ELEVATOR EXIT] Berhasil keluar lurus ke koridor depan Lift!")
    end
end

-- Smart Single-Layer Route + NavMesh Fallback
local function safeSingleLayerTween(targetCF, speed, ignoreThreat, customCancelFn)
    if not rootPart then return false end

    -- Wajib keluar lurus dari pintu depan Elevator dulu jika posisi awal masih di dalam Lift!
    ensureExitedElevator()
    if abortCurrentMovement or not isMasterFarming or not rootPart then return true end

    local walkY    = getSafeWalkY(rootPart.Position.Y)
    local goalY    = getTargetStandingY(targetCF.Position.Y, true)
    local startPos = Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z)
    local goalPos  = Vector3.new(targetCF.Position.X, goalY, targetCF.Position.Z)

    local goalCol = nil
    for _, col in ipairs(getNoClipColliders()) do
        if col and col.Parent and isPointInsideExpandedBox(goalPos, col, 1.5, 2.0) then
            goalCol = col
            break
        end
    end

    local routeWps, okOneLayer, penetratedCol = buildSmartOneLayerRoute(startPos, goalPos, goalCol)

    if okOneLayer and #routeWps > 0 then
        if penetratedCol then setTargetColliderPassable(penetratedCol, true) end
        if goalCol then setTargetColliderPassable(goalCol, true) end
        forceCharNoClip = true

        local cancelled = false
        for _, wp in ipairs(routeWps) do
            if abortCurrentMovement or not isMasterFarming then
                cancelled = true
                break
            end
            cancelled = teleportTween(CFrame.new(wp), speed or Config.Teleport.TweenSpeed, ignoreThreat, true, customCancelFn)
            if cancelled or abortCurrentMovement then
                break
            end
        end

        setTargetColliderPassable(nil, false)

        if abortCurrentMovement then return true end

        if cancelled then
            if customCancelFn and customCancelFn() then
                return true
            end
            if not ignoreThreat and isThreatened() then
                local resumed = performColliderHide("Ter-spot saat gerak menuju target!")
                if resumed and not abortCurrentMovement and isMasterFarming then
                    return safeSingleLayerTween(targetCF, speed, ignoreThreat, customCancelFn)
                end
            end
            return true
        end

        task.wait(0.06)
        if rootPart and Vector2.new(rootPart.Position.X - goalPos.X, rootPart.Position.Z - goalPos.Z).Magnitude <= 6.5 then
            return false
        else
            recordFailedRollbackZone(routeWps[1])
        end
    end

    if Config.Teleport.PathfindFallback and not isPathfinding and not abortCurrentMovement then
        return pathfindTween(CFrame.new(goalPos), 1, true, customCancelFn)
    end

    return false
end

-- [FITUR KHUSUS GENERATOR] Hybrid Y-Bypass (Tween ke Collider -> Instant Y-Bypass -> Instant ke Generator)
local function executeHybridYTeleport(targetCF)
    if not rootPart then return false end

    print("[HYBRID Y-BYPASS] 1/3 Menuju tengah Thick Collider terdekat...")
    local centerPos = moveIntoNearestColliderCenter(Config.Teleport.TweenSpeed, false)
    if abortCurrentMovement or not rootPart or not isMasterFarming then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    if not centerPos then
        if isThreatened() then
            performColliderHide("Ter-spot saat menuju Collider awal Hybrid Y-Bypass!")
            if abortCurrentMovement or not isMasterFarming then return false end
        end
        centerPos = moveIntoNearestColliderCenter(Config.Teleport.TweenSpeed, true)
    end
    if not centerPos then centerPos = rootPart.Position end

    task.wait(0.05)

    local bypassY   = Config.Teleport.HybridBypassY or -241
    local waitDelay = math.max(Config.Teleport.HybridBypassDelay or 0.40, 0.05)
    local bypassCF  = CFrame.new(centerPos.X, bypassY, centerPos.Z)

    print(string.format("[HYBRID Y-BYPASS] 2/3 Stay di Y=%d selama %.2f detik...", bypassY, waitDelay))
    Workspace.Gravity = 0
    teleportplr(bypassCF, true)

    local holdConn = RunService.Heartbeat:Connect(function()
        if rootPart and not abortCurrentMovement and isMasterFarming then
            rootPart.AssemblyLinearVelocity  = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = bypassCF
        end
    end)

    local elapsed = 0
    while elapsed < waitDelay and not abortCurrentMovement and isMasterFarming do
        local step = math.min(0.05, waitDelay - elapsed)
        task.wait(step)
        elapsed = elapsed + step
    end

    if holdConn then holdConn:Disconnect() end

    if abortCurrentMovement or not rootPart or not isMasterFarming then
        setTargetColliderPassable(nil, false)
        restoreNormalGravity()
        return false
    end

    local destPos     = targetCF.Position
    local finalDestCF = CFrame.new(destPos)
    print(string.format("[HYBRID Y-BYPASS] 3/3 Loncat Instant ke Generator (%.0f, %.0f, %.0f)!", destPos.X, destPos.Y, destPos.Z))
    teleportplr(finalDestCF, true)
    task.wait(0.06)
    teleportplr(finalDestCF, false)

    setTargetColliderPassable(nil, false)
    restoreNormalGravity()

    -- Tunggu sebentar untuk memverifikasi apakah server menerima posisi kita atau melakukan rollback/revert
    task.wait(0.12)
    if rootPart then
        local flatDist = Vector2.new(rootPart.Position.X - destPos.X, rootPart.Position.Z - destPos.Z).Magnitude
        if flatDist <= 8.5 then
            return true -- BERHASIL SAMPAI DI GENERATOR!
        end
    end

    return false -- GAGAL / KENA REVERT SERVER
end

-- Fungsi Perpindahan Khusus Generator
local function moveToPositionGen(targetCFrame, isGeneratorTarget)
    if not rootPart then return end
    rootPart.Anchored = false

    -- Wajib keluar lurus dari pintu depan Lift terlebih dahulu sebelum boleh teleport kemana pun!
    ensureExitedElevator()
    if abortCurrentMovement or not isMasterFarming or not rootPart then return end

    local flatDist   = Vector2.new(rootPart.Position.X - targetCFrame.Position.X, rootPart.Position.Z - targetCFrame.Position.Z).Magnitude
    local minHybDist = Config.Teleport.HybridMinDistance or 75

    local walkY = getSafeWalkY(rootPart.Position.Y)
    local okDirect1Layer = analyzeSegmentLayers(
        Vector3.new(rootPart.Position.X, walkY, rootPart.Position.Z),
        Vector3.new(targetCFrame.Position.X, walkY, targetCFrame.Position.Z),
        nil, 1.35
    )
    local shouldUseHybrid = isGeneratorTarget
        and Config.Teleport.HybridYMode
        and (flatDist >= minHybDist)
        and not (okDirect1Layer and flatDist <= (minHybDist + 15))

    if shouldUseHybrid then
        print(string.format("[GENERATOR MOVE] Jarak mesin jauh (%.0f studs >= %d). Mencoba Hybrid Y-Bypass...", flatDist, minHybDist))
        local okHybrid = executeHybridYTeleport(targetCFrame)
        if okHybrid then
            return
        end
        if abortCurrentMovement or not isMasterFarming then return end
        print("[HYBRID FALLBACK] Hybrid Y-Bypass terkena revert/gagal! Beralih otomatis ke Dual-Speed Tween (3.50 / 1.05)...")
    end

    -- Mode Utama / Jarak Dekat / Fallback: Dual-Speed Tween (3.50 / 1.05)
    if Config.Teleport.Mode == "Instant" then
        teleportplr(targetCFrame, false)
        task.wait(0.05)
    else
        safeSingleLayerTween(targetCFrame, Config.Teleport.TweenSpeed, false)
    end
end

