local function getMap()
    local cr = Workspace:FindFirstChild("CurrentRoom")
    return cr and cr:FindFirstChildWhichIsA("Model")
end

local function getModelCenter(model)
    if not model or not model:IsA("Model") then return nil end
    local total, n = Vector3.zero, 0
    for _, p in pairs(model:GetDescendants()) do
        if p:IsA("BasePart") then
            total = total + p.Position
            n = n + 1
        end
    end
    return n > 0 and (total / n) or nil
end

local function getMonsterPart(monster)
    if not monster or not monster:IsA("Model") then return nil end
    return monster.PrimaryPart
        or monster:FindFirstChild("HumanoidRootPart")
        or monster:FindFirstChildWhichIsA("BasePart", true)
end

local function getWorldBoxSize(part)
    local cf = part.CFrame
    local sz = part.Size
    local wx = math.abs(cf.RightVector.X) * sz.X + math.abs(cf.UpVector.X) * sz.Y + math.abs(cf.LookVector.X) * sz.Z
    local wy = math.abs(cf.RightVector.Y) * sz.X + math.abs(cf.UpVector.Y) * sz.Y + math.abs(cf.LookVector.Y) * sz.Z
    local wz = math.abs(cf.RightVector.Z) * sz.X + math.abs(cf.UpVector.Z) * sz.Y + math.abs(cf.LookVector.Z) * sz.Z
    return Vector3.new(wx, wy, wz)
end

local function getSafeWalkY(referenceY)
    if rootPart and rootPart.Position.Y > -50 and rootPart.Position.Y < 200 then
        return rootPart.Position.Y
    end
    return referenceY or 100
end

local function getTargetStandingY(rawTargetY, isAlreadyStandingHeight)
    local walkY = getSafeWalkY(rawTargetY)
    if not rawTargetY then return walkY end
    local standY = isAlreadyStandingHeight and rawTargetY or (rawTargetY + 3.0)
    if math.abs(standY - walkY) <= 1.8 then
        return walkY
    end
    return standY
end

local function clampPositionAboveFloor(pt)
    local walkY = getSafeWalkY(pt.Y)
    if math.abs(pt.Y - walkY) <= 1.8 then
        return Vector3.new(pt.X, walkY, pt.Z)
    end
    return Vector3.new(pt.X, pt.Y, pt.Z)
end

local function getSafePlaceCFrame()
    local elevators = Workspace:FindFirstChild("Elevators")
    if elevators then
        for _, el in ipairs(elevators:GetChildren()) do
            if el.Name == "Elevator" and el:IsA("Model") then
                local dandyStore = el:FindFirstChild("DandyStore")
                local dandyShop  = dandyStore and dandyStore:FindFirstChild("DandyShop")
                local root       = dandyShop and dandyShop:FindFirstChild("RootPart")
                if root then
                    return root.CFrame * CFrame.new(0, 3, 0)
                end
            end
        end
    end
    
    local map = getMap()
    if map then
        local freeArea     = map:FindFirstChild("FreeArea")
        local fakeElevator = freeArea and freeArea:FindFirstChild("FakeElevator")
        if fakeElevator and fakeElevator:IsA("Model") then 
            local center = getModelCenter(fakeElevator)
            if center then return CFrame.new(center) end
        end
    end
    return nil
end

local function getRealElevatorCFrame()
    local walkY  = (rootPart and rootPart.Position.Y > -50 and rootPart.Position.Y < 200) and rootPart.Position.Y or nil
    local curMap = getMap()

    if cachedRealElevCF and cachedRealElevRoom == curMap then
        return CFrame.new(cachedRealElevCF.X, walkY or cachedRealElevCF.Y, cachedRealElevCF.Z)
    end

    local elevatorsFolder = Workspace:FindFirstChild("Elevators")
    if elevatorsFolder then
        for _, obj in ipairs(elevatorsFolder:GetChildren()) do
            if obj.Name == "Elevator" and obj:IsA("Model") then
                if obj.PrimaryPart then 
                    local p = obj.PrimaryPart.Position
                    cachedRealElevCF   = CFrame.new(p.X, p.Y + 3, p.Z)
                    cachedRealElevRoom = curMap
                    return CFrame.new(p.X, walkY or (p.Y + 3), p.Z)
                else
                    local centerPos = getModelCenter(obj)
                    if centerPos then
                        cachedRealElevCF   = CFrame.new(centerPos.X, centerPos.Y + 3, centerPos.Z)
                        cachedRealElevRoom = curMap
                        return CFrame.new(centerPos.X, walkY or (centerPos.Y + 3), centerPos.Z)
                    end
                end
            end
        end
        for _, obj in ipairs(elevatorsFolder:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                cachedRealElevCF   = cf
                cachedRealElevRoom = curMap
                return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
            end
        end
    end
    
    local room = Workspace:FindFirstChild("CurrentRoom")
    if room then
        for _, obj in ipairs(room:GetDescendants()) do
            if obj.Name == "ElevatorPrompt" and obj:IsA("BasePart") then
                local parentName = string.lower(obj.Parent and obj.Parent.Name or "")
                if not string.find(parentName, "fake") then
                    local cf = obj.CFrame * CFrame.new(0, 1.5, 2)
                    cachedRealElevCF   = cf
                    cachedRealElevRoom = curMap
                    return CFrame.new(cf.X, walkY or cf.Y, cf.Z)
                end
            end
        end
    end
    return nil
end

-- Menentukan titik berdiri tepat di depan Tuas / Prompt / Origin Generator
local function getGeneratorTargetCFrame(gen)
    if not gen then return nil end
    local targetPart = gen:FindFirstChild("Prompt")
        or gen:FindFirstChild("Origin")
        or gen:FindFirstChild("InvisBlock")

    if not targetPart then
        for _, desc in ipairs(gen:GetDescendants()) do
            if desc:IsA("ProximityPrompt") then
                targetPart = desc:FindFirstAncestorWhichIsA("BasePart")
                    or (desc.Parent and desc.Parent:IsA("Model") and desc.Parent.PrimaryPart)
                if targetPart then break end
            end
        end
    end

    targetPart = targetPart or gen.PrimaryPart or gen:FindFirstChildWhichIsA("BasePart", true)
    if targetPart then
        local gPos = targetPart:IsA("BasePart") and targetPart.Position or gen:GetPivot().Position
        local standY = getTargetStandingY(gPos.Y, false) + (Config.Teleport.UndergroundOffset or 0)
        return CFrame.new(gPos.X, standY, gPos.Z)
    end
    return nil
end

local function getMachineProgress()
    local pGui = player:FindFirstChild("PlayerGui")
    if pGui then
        -- 1. Cek di SpectatorGui -> InfoFrame -> GeneratorFrame (Struktur Lama)
        local specGui  = pGui:FindFirstChild("SpectatorGui")
        local info     = specGui and specGui:FindFirstChild("InfoFrame")
        local genFrame = info and info:FindFirstChild("GeneratorFrame")
        local msg      = genFrame and genFrame:FindFirstChild("Message")
        if msg and msg:IsA("TextLabel") then
            local cur, tot = string.match(msg.Text, "Machines Completed: (%d+)/(%d+)")
            if cur and tot then
                return tonumber(cur), tonumber(tot)
            end
        end
        -- 2. Cek di TopBar -> GeneratorFrame -> Message (Struktur Baru)
        for _, gui in ipairs(pGui:GetChildren()) do
            local topBar = gui:FindFirstChild("TopBar", true)
            local gf     = (topBar and topBar:FindFirstChild("GeneratorFrame")) or gui:FindFirstChild("GeneratorFrame", true)
            local m      = gf and gf:FindFirstChild("Message")
            if m and m:IsA("TextLabel") then
                local cur, tot = string.match(m.Text, "Machines Completed: (%d+)/(%d+)")
                if cur and tot then
                    return tonumber(cur), tonumber(tot)
                end
            end
        end
    end
    return -1, -1
end

local function getEmptyInventorySlots()
    local char = player.Character
    if not char then return 0 end
    local inv = char:FindFirstChild("Inventory")
    if not inv then return 0 end
    
    local emptyCount = 0
    for i = 1, 4 do
        local slot = inv:FindFirstChild("Slot" .. i)
        if slot and (slot.Value == "" or slot.Value == "None") then
            emptyCount = emptyCount + 1
        end
    end
    return emptyCount
end

