local rangeDangerFill, rangeDangerRing, rangeLooseRing = nil, nil, nil

local function updateMonsterESP()
    local map = getMap()
    if not map then return end
    
    local monstersFolder = map:FindFirstChild("Monsters")
    if not monstersFolder then return end

    -- Sinkronisasi Config.LineESP dan Config.MonsterESP.LineESP
    local useLineESP = (Config.LineESP == true) or (Config.MonsterESP and Config.MonsterESP.LineESP == true)

    local originAtt = nil
    if Config.MonsterESP.Enable and useLineESP and rootPart then
        originAtt = rootPart:FindFirstChild("_LineESPOrigin")
        if not originAtt then
            originAtt        = Instance.new("Attachment")
            originAtt.Name   = "_LineESPOrigin"
            originAtt.Parent = rootPart
        end
    elseif rootPart then
        local oldOrigin = rootPart:FindFirstChild("_LineESPOrigin")
        if oldOrigin then oldOrigin:Destroy() end
    end

    for _, monster in pairs(monstersFolder:GetChildren()) do
        local mPart = getMonsterPart(monster)
        if monster:IsA("Model") and mPart then
            if Config.MonsterESP.Enable then
                local isPassive = isLooseMonsterName(monster.Name)
                local fillCol   = isPassive and Color3.fromRGB(255, 140, 0) or Config.MonsterESP.Color
                local tagTxt    = isPassive and "[PASIF]\n" or "[MONSTER]\n"

                local highlight = monster:FindFirstChild("MonsterESP")
                if not highlight then
                    highlight                  = Instance.new("Highlight", monster)
                    highlight.Name             = "MonsterESP"
                    highlight.OutlineColor     = Color3.fromRGB(255, 255, 255)
                    highlight.FillTransparency = 0.5
                end
                highlight.FillColor = fillCol
                
                local billboard = monster:FindFirstChild("MonsterText")
                local label
                if not billboard then
                    billboard             = Instance.new("BillboardGui", monster)
                    billboard.Name        = "MonsterText"
                    billboard.Size        = UDim2.new(0, 150, 0, 50)
                    billboard.AlwaysOnTop = true
                    billboard.Adornee     = mPart
                    
                    label                        = Instance.new("TextLabel", billboard)
                    label.Name                   = "Text"
                    label.Size                   = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Font                   = Enum.Font.Nunito
                    label.TextStrokeTransparency = 0.5
                    label.TextSize               = 14
                else 
                    label = billboard:FindFirstChild("Text")
                end
                if label then
                    label.TextColor3 = fillCol
                    label.Text       = tagTxt .. monster.Name
                end

                if useLineESP and originAtt then
                    local ta = mPart:FindFirstChild("_LineESPTarget")
                    if not ta then
                        ta        = Instance.new("Attachment")
                        ta.Name   = "_LineESPTarget"
                        ta.Parent = mPart
                    end
                    local beam = mPart:FindFirstChild("_LineESPBeam")
                    if not beam then
                        beam                = Instance.new("Beam")
                        beam.Name           = "_LineESPBeam"
                        beam.Attachment0    = originAtt
                        beam.Attachment1    = ta
                        beam.Color          = ColorSequence.new(Color3.fromRGB(255, 50, 50), Color3.fromRGB(255, 150, 0))
                        beam.Width0         = 0.08
                        beam.Width1         = 0.08
                        beam.FaceCamera     = true
                        beam.Transparency   = NumberSequence.new(0.2)
                        beam.LightEmission  = 1
                        beam.Segments       = 1
                        beam.Parent         = mPart
                    end
                else
                    local oldBeam = mPart:FindFirstChild("_LineESPBeam")
                    if oldBeam then oldBeam:Destroy() end
                    local oldTa = mPart:FindFirstChild("_LineESPTarget")
                    if oldTa then oldTa:Destroy() end
                end
            end
        end
    end
end

