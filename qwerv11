-- [SECTION 9] GENERATOR AUTO-FARM (HYBRID Y-BYPASS -> DUAL-SPEED TWEEN FALLBACK)
-- ==============================================================================
local function forceTriggerGenerator(generator)
    for _, descendant in ipairs(generator:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            descendant.RequiresLineOfSight   = false
            descendant.MaxActivationDistance = math.huge 
            if fireproximityprompt then
                fireproximityprompt(descendant, 1)
            else
                pcall(function() descendant:InputHoldBegin() end)
            end
            return true
        end
    end
    return false
end

local function startAutoFarming()
    farmingSessionId = farmingSessionId + 1
    local mySession  = farmingSessionId

    local inElevatorStandby     = false
    local hasVerifiedInElevator = false

    -- Thread 1: Loop Update ESP & Visual Radius
    task.spawn(function()
        while isMasterFarming and farmingSessionId == mySession do
            updateGeneratorESP()
            updateMonsterESP() 
            updateSafeRadiusVisual()
            applyItemESP()
            task.wait(0.2)
        end
        clearSafeRadiusVisual()
    end)

    -- Thread 2: Loop Auto-Skillcheck Override
    task.spawn(function()
        while isMasterFarming and farmingSessionId == mySession do
            if Config.Skillcheck and Config.Skillcheck.Enable then
                pcall(function()
                    local events = ReplicatedStorage:FindFirstChild("Events")
                    if events then
                        local su = events:FindFirstChild("SkillcheckUpdate")
                        if su then su.OnClientInvoke = function() return true end end
                    end
                end)
            end
            task.wait(1)
        end
    end)

    -- Thread 3: Main Generator Farming Loop
    task.spawn(function()
        while isMasterFarming and farmingSessionId == mySession do
            if isItemFarmingActive or isEmergencyHiding then
                task.wait(0.1)
                continue
            end

            character = player.Character
            if not character then task.wait(0.5) continue end
            rootPart = character:FindFirstChild("HumanoidRootPart")
            if not rootPart then task.wait(0.5) continue end

            -- Hirarki Tertinggi: Langsung sembunyi jika ter-spot (Simbol Mata) atau monster masuk SafeRadius
            if isThreatened() then
                performColliderHide("Ter-spot sebelum menuju Generator!")
                continue
            end

            if Config.Teleport.Enable then
                local map = getMap()
                if map then
                    local genFolder = map:FindFirstChild("Generators")
                    if genFolder then
                        
                        local uncompletedCount  = 0
                        local candidateGens     = {}
                        local fallbackEmptyGens = {}
                        local genSafeRad        = Config.Teleport.GeneratorSafeRadius or 18
                        
                        for _, gen in pairs(genFolder:GetChildren()) do
                            if gen:IsA("Model") then
                                local stats = gen:FindFirstChild("Stats")
                                if stats then
                                    local completed = stats:FindFirstChild("Completed") and stats.Completed.Value
                                    local connie    = stats:FindFirstChild("Connie") and stats.Connie.Value
                                    
                                    if not completed then
                                        uncompletedCount = uncompletedCount + 1
                                        if not connie then
                                            local genCF = getGeneratorTargetCFrame(gen)
                                            if genCF and not isMachineOccupied(gen, Config.Teleport.PlayerRadius) then
                                                local dist = (rootPart.Position - genCF.Position).Magnitude
                                                local monsterDist = getMinDistanceToMonsters(genCF.Position)
                                                if not isThreatened(genCF.Position, genSafeRad) then
                                                    table.insert(candidateGens, { gen = gen, cf = genCF, dist = dist, mDist = monsterDist })
                                                elseif monsterDist > 12 then
                                                    table.insert(fallbackEmptyGens, { gen = gen, cf = genCF, dist = dist, mDist = monsterDist })
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end

                        if #candidateGens == 0 and #fallbackEmptyGens > 0 then
                            table.sort(fallbackEmptyGens, function(a, b) return a.mDist > b.mDist end)
                            table.insert(candidateGens, fallbackEmptyGens[1])
                        end
                        
                        table.sort(candidateGens, function(a, b) return a.dist < b.dist end)
                        local chosenEntry  = candidateGens[1]
                        local targetGen    = chosenEntry and chosenEntry.gen
                        local targetCFrame = chosenEntry and chosenEntry.cf
                        
                        local curGenUI, totGenUI = getMachineProgress()
                        local isFloorActuallyDone = false
                        
                        if curGenUI ~= -1 and totGenUI ~= -1 and totGenUI > 0 then
                            isFloorActuallyDone = (curGenUI >= totGenUI)
                        else
                            isFloorActuallyDone = (uncompletedCount == 0)
                        end
                        
                        -- Jika semua mesin selesai -> Menuju Real Elevator (Mendukung ForceLockInElevator true / false)
                        if isFloorActuallyDone then
                            if not inElevatorStandby then
                                print("[INFO] Semua Mesin Selesai (Verified)! Menuju Real Elevator...")
                                inElevatorStandby     = true
                                hasVerifiedInElevator = false
                            end
                            
                            local elevatorTarget = getRealElevatorCFrame()
                            if elevatorTarget then
                                local dist = Vector2.new(rootPart.Position.X - elevatorTarget.Position.X, rootPart.Position.Z - elevatorTarget.Position.Z).Magnitude

                                if Config.Teleport.ForceLockInElevator then
                                    -- Mode TRUE: Teleport paksa terus-menerus sampai pintu lift tertutup
                                    if dist > 4.5 then
                                        teleportplr(elevatorTarget, false)
                                    else
                                        if rootPart.Anchored then rootPart.Anchored = false end
                                    end
                                else
                                    -- Mode FALSE: Teleport 1x saja, wajib terverifikasi sudah berada di dalam Real Elevator!
                                    if not hasVerifiedInElevator then
                                        for _ = 1, 5 do
                                            if not rootPart or abortCurrentMovement or not isMasterFarming then break end
                                            teleportplr(elevatorTarget, false)
                                            task.wait(0.12)
                                            if rootPart then
                                                local checkDist = Vector2.new(rootPart.Position.X - elevatorTarget.Position.X, rootPart.Position.Z - elevatorTarget.Position.Z).Magnitude
                                                if checkDist <= 10.0 then
                                                    hasVerifiedInElevator = true
                                                    if rootPart.Anchored then rootPart.Anchored = false end
                                                    print("[ELEVATOR] Terverifikasi sudah di dalam Real Elevator! (1x Teleport Selesai, bebas bergerak)")
                                                    break
                                                end
                                            end
                                        end
                                    else
                                        if dist > 14.5 then
                                            hasVerifiedInElevator = false
                                        elseif rootPart.Anchored then
                                            rootPart.Anchored = false
                                        end
                                    end
                                end
                            end
                            task.wait(0.4) 
                            
                        elseif targetGen and targetCFrame then
                            inElevatorStandby     = false
                            hasVerifiedInElevator = false
                            
                            -- Pindah ke Generator (Otomatis pakai Hybrid Y-Bypass dulu jika ON, lalu fallback ke Dual-Speed Tween 3.5/1.05)
                            moveToPositionGen(targetCFrame, true)
                            
                            if abortCurrentMovement or not isMasterFarming or isItemFarmingActive then
                                continue
                            end

                            local isContested  = false
                            local monsterEvade = false
                            local needSync     = isTrinketActive()
                            
                            if needSync then
                                local minD = Config.Teleport.SyncDelayMin
                                local maxD = Config.Teleport.SyncDelayMax
                                local syncDelay = minD + (math.random() * (maxD - minD))
                                
                                print(string.format("[SYNC] Trinket 'Active'! Menunggu %.2f detik...", syncDelay))
                                
                                local elapsed = 0
                                while elapsed < syncDelay do
                                    if isThreatened() then
                                        monsterEvade = true
                                        break
                                    end
                                    task.wait(0.04)
                                    elapsed = elapsed + 0.04
                                end
                                
                                if not monsterEvade and isMachineOccupied(targetGen, Config.Teleport.PlayerRadius) then
                                    isContested = true
                                end
                            else
                                if isThreatened() then
                                    monsterEvade = true
                                elseif isMachineOccupied(targetGen, Config.Teleport.PlayerRadius) then
                                    isContested = true
                                end
                            end
                            
                            if monsterEvade then
                                performColliderHide("Ter-spot / Monster dekat saat mendarat di Generator!")
                            elseif isContested then
                                print("[SAFETY] Mesin direbut pemain lain. Batal ekstrak, cari mesin lain.")
                            else
                                local hasStartedInteracting = false
                                local instantNext = false
                                local failTimer = 0 
                                
                                local invisBlock = targetGen:FindFirstChild("InvisBlock")
                                if invisBlock and invisBlock:IsA("BasePart") then invisBlock.CanCollide = false end

                                -- Loop Ekstraksi Mesin dengan Deteksi Refleks Cepat (0.04 detik)
                                while isMasterFarming and farmingSessionId == mySession and targetGen.Parent and not isItemFarmingActive do
                                    -- [HIRARKI MUTLAK #1] Cek ancaman monster terlebih dahulu sebelum apa pun!
                                    if isThreatened() then
                                        forceStop()
                                        performColliderHide("Ter-spot / Monster mendekat saat ekstraksi Generator!")
                                        instantNext = true
                                        break
                                    end

                                    if isItemFarmingActive then
                                        forceStop()
                                        instantNext = true
                                        break
                                    end

                                    local stats = targetGen:FindFirstChild("Stats")
                                    if stats and stats:FindFirstChild("Completed") and stats.Completed.Value then
                                        instantNext = true
                                        break 
                                    end
                                    
                                    if isMachineOccupied(targetGen, Config.Teleport.PlayerRadius) then
                                        print("[SAFETY] Pemain lain mendekat saat ekstrak. Ngalah cabut.")
                                        forceStop()
                                        task.wait(0.05)
                                        instantNext = true
                                        break
                                    end
                                    
                                    local flatDistToGen = Vector2.new(rootPart.Position.X - targetCFrame.Position.X, rootPart.Position.Z - targetCFrame.Position.Z).Magnitude
                                    if flatDistToGen > 4.5 then
                                        teleportplr(targetCFrame, false)
                                    end

                                    local currentlyInteracting = isInteractingUI()
                                    if currentlyInteracting then
                                        hasStartedInteracting = true
                                        failTimer = 0 
                                    elseif hasStartedInteracting and not currentlyInteracting then
                                        forceStop()
                                        instantNext = true
                                        break
                                    else
                                        forceTriggerGenerator(targetGen)
                                        failTimer = failTimer + 1
                                        if failTimer == 20 then
                                            local refreshedCF = getGeneratorTargetCFrame(targetGen) or targetCFrame
                                            teleportplr(refreshedCF, false)
                                        elseif failTimer >= 50 then
                                            forceStop()
                                            instantNext = true
                                            break
                                        end
                                    end
                                    task.wait(0.04)
                                end
                                
                                clearAllServerSyncedHolds()
                                restoreNormalGravity()
                                if instantNext then
                                    task.wait(0.05)
                                else
                                    task.wait(Config.Teleport.DelayNext)
                                end
                            end
                            
                        else
                            inElevatorStandby     = false
                            hasVerifiedInElevator = false
                            local progressText = (curGenUI ~= -1) and (" (" .. curGenUI .. "/" .. totGenUI .. ")") or ""
                            print("[INFO] Mesin belum selesai" .. progressText .. " tapi semua mesin sedang dijaga monster. Standby di tengah Thick Collider...")
                            moveIntoNearestColliderCenter(Config.Teleport.TweenSpeed, true)
                            task.wait(1.2)
                            setTargetColliderPassable(nil, false)
                        end
                    end
                end
            end
            task.wait(0.06)
        end
    end)
end

-- ==============================================================================
-- [SECTION 10] MASTER WATCHER & FAILSAFE (PEMANTAU UTAMA & ANTI-STUCK)
-- ==============================================================================
local hasSweptHeals    = false
local lastGenCount     = -1
local lastProgressTick = tick()

task.spawn(function()
    while task.wait(0.2) do 
        if not isMasterFarming then 
            lastProgressTick = tick()
            continue 
        end

        local curGen, totGen = getMachineProgress()
        
        if curGen == 0 then
            hasSweptHeals = false 
        end
        
        -- Pengecekan Failsafe Hard Reboot (Tidak menghitung waktu saat sedang ambil item atau sedang bersembunyi dari monster)
        if not isItemFarmingActive and not isEmergencyHiding then
            if curGen ~= lastGenCount then
                lastGenCount = curGen
                lastProgressTick = tick() 
            end
            
            if tick() - lastProgressTick >= Config.failsafegenerator then
                print("\n==============================================")
                print("[FAILSAFE] Script stuck/bengong selama " .. Config.failsafegenerator .. " detik! Melakukan HARD REBOOT...")
                print("==============================================")
                
                abortCurrentMovement = true
                forceStop()
                clearAllServerSyncedHolds()
                setTargetColliderPassable(nil, false)
                restoreNormalGravity()
                if rootPart then rootPart.Anchored = false end
                
                local safePos = getSafePlaceCFrame()
                if safePos then teleportplr(safePos) end
                
                isMasterFarming = false 
                task.wait(2)
                
                print("[FAILSAFE] Reboot Selesai. Memulai ulang script...")
                abortCurrentMovement = false
                lastProgressTick = tick() 
                isMasterFarming = true
                startAutoFarming()
                
                continue
            end
        else
            lastProgressTick = tick() 
        end

        -- Smart Pickup: Coba ambil ulang item heal jika sisa 1 mesin & slot tas kosong
        if curGen > 0 and totGen > 0 and curGen == (totGen - 1) and not hasSweptHeals then
            if getEmptyInventorySlots() > 0 then
                local unblacklistedAny = false
                local map = getMap()
                local itemsFolder = map and map:FindFirstChild("Items")
                if itemsFolder then
                    for _, item in ipairs(itemsFolder:GetChildren()) do
                        if isSecondPriority(item.Name) and item:GetAttribute("BlacklistLimbo") then
                            item:SetAttribute("BlacklistLimbo", nil) 
                            local highlight = item:FindFirstChild("ItemESP")
                            if highlight then highlight.FillColor = Color3.fromRGB(255, 100, 255) end 
                            unblacklistedAny = true
                        end
                    end
                end
                if unblacklistedAny then
                    print("[SMART PICKUP] Sisa 1 Mesin & Tas Kosong! Menghapus Blacklist Healing Item...")
                end
            end
            hasSweptHeals = true
        end

        -- Deteksi Item Baru / Lantai Baru (Menghormati MonsterCooldownUntil agar tidak bolak-balik di depan monster)
        local map = getMap()
        if map and Config.Pickup.Enable then
            local itemsFolder = map:FindFirstChild("Items")
            if itemsFolder then
                local hasSafeValidItems = false
                local nowClock = os.clock()
                for _, item in ipairs(itemsFolder:GetChildren()) do
                    if item:IsA("Model") and not isIgnored(item.Name) and not item:GetAttribute("BlacklistLimbo") then
                        local cdAttr = item:GetAttribute("MonsterCooldownUntil") or 0
                        if nowClock >= cdAttr then
                            local ok, iPos = pcall(function() return item:GetPivot().Position end)
                            if ok and iPos and not isItemAreaDangerous(iPos) then
                                hasSafeValidItems = true
                                break
                            end
                        end
                    end
                end

                local veeRemotePending = Config.Teleport.UseVeeRemoteFirst and isTrinketActive() and (curGen == 0)

                if hasSafeValidItems and not isItemFarmingActive and not isEmergencyHiding and not veeRemotePending then
                    if isInteractingUI() then
                        print("[SYSTEM] Item aman terdeteksi, menunggu ekstraksi mesin saat ini selesai...")
                    end
                    
                    local interruptedByMonster = false
                    while isInteractingUI() and isMasterFarming do
                        if isThreatened() then
                            forceStop()
                            performColliderHide("Ter-spot saat menunggu ekstraksi selesai!")
                            interruptedByMonster = true
                            break
                        end
                        task.wait(0.05)
                        lastProgressTick = tick()
                    end

                    -- Jika baru saja diinterupsi oleh monster, jangan langsung paksa ambil item!
                    if interruptedByMonster or isEmergencyHiding or isThreatened() then
                        continue
                    end
                    
                    isItemFarmingActive = true
                    
                    print("\n==============================================")
                    print("[SYSTEM] Mendeteksi Item Aman / Lantai Baru! Mengambil item...")
                    print("==============================================")
                    
                    forceStop()
                    if rootPart then rootPart.Anchored = false end
                    
                    character = player.Character
                    if not character then 
                        isItemFarmingActive = false 
                        continue 
                    end
                    rootPart = character:FindFirstChild("HumanoidRootPart")
                    if not rootPart then 
                        isItemFarmingActive = false 
                        continue 
                    end
                    
                    local success, err = pcall(function()
                        executePickup() 
                    end)
                    
                    if not success then
                        print("[WARNING] Error saat executePickup: ", err)
                    end
                    
                    isItemFarmingActive = false
                    lastProgressTick = tick() 
                end
            end
        end
    end
end)

-- ==============================================================================
-- [SECTION 11] BARNABY AUTO-PLAY LISTENER (AUTO MINIGAME BARNABY)
-- ==============================================================================
task.spawn(function()
    local Events = ReplicatedStorage:WaitForChild("Events", 10)
    if not Events then return end
    
    local BarnabyEnterEvent  = Events:WaitForChild("BarnabyEnterEvent", 5)
    local BarnabyTickEvent   = Events:WaitForChild("BarnabyTickEvent", 5)
    local BarnabyCoinEvent   = Events:WaitForChild("BarnabyCoinEvent", 5)
    local BarnabyBootedEvent = Events:WaitForChild("BarnabyBootedEvent", 5)

    if BarnabyEnterEvent then
        BarnabyEnterEvent.OnClientEvent:Connect(function(generator, genId, extraData)
            if not isMasterFarming or not Config.Barnaby.AutoPlay then return end
            
            _G.IsBarnabyActive = true
            print("[BARNABY AUTO-WIN] Minigame started! Auto-playing...")
            
            task.spawn(function()
                local pGui = player:FindFirstChild("PlayerGui")
                if pGui and pGui:FindFirstChild("ClientUI") and pGui.ClientUI:FindFirstChild("GameWindow") then
                    pGui.ClientUI.GameWindow.Visible = false
                end
                
                local ticks = 0
                while _G.IsBarnabyActive and isMasterFarming do
                    if BarnabyTickEvent then BarnabyTickEvent:FireServer(genId, 1) end
                    
                    if ticks % 2 == 0 then
                        if BarnabyCoinEvent then BarnabyCoinEvent:FireServer(genId) end
                    end
                    
                    local stats = generator:FindFirstChild("Stats")
                    if stats then
                        local current     = stats:FindFirstChild("CurrentAmount") and stats.CurrentAmount.Value or 0
                        local required    = stats:FindFirstChild("RequiredAmount") and stats.RequiredAmount.Value or 100
                        local isCompleted = stats:FindFirstChild("Completed") and stats.Completed.Value
                        
                        if current >= required or isCompleted then
                            if BarnabyBootedEvent then BarnabyBootedEvent:FireServer(genId, generator) end
                            _G.IsBarnabyActive = false
                            print("[BARNABY AUTO-WIN] Minigame completed!")
                            break
                        end
                    end
                    
                    local decoding = player.Character and player.Character:FindFirstChild("Decoding")
                    if not decoding then
                        _G.IsBarnabyActive = false
                        break
                    end
                    
                    task.wait(0.5)
                    ticks = ticks + 1
                end
            end)
        end)
    end
end)

