    local lower = mName:lower()
    for _, looseName in ipairs(Config.Teleport.LooseMonsters or {}) do
        if mName == looseName or lower:find(looseName:lower(), 1, true) then
            return true
        end
    end
    if lower:find("blott") or lower:find("squirm") or lower:find("razzle") or lower:find("rodger") or lower:find("connie") or lower:find("gourdy") then
        return true
    end
    return false
end

local function isLethalMonsterName(mName)
    if not mName then return false end
    for _, lethalName in ipairs(Config.Teleport.AvoidmoreradiusMonsters or {}) do
        if mName == lethalName then
            return true
        end
    end
    return false
end

-- Deteksi khusus apakah Simbol Mata muncul atau Monster mengunci karakter kita
local function isPlayerSpotted()
    if Config.Teleport.SuperSafeMonsterDetect then
        local pGui      = player:FindFirstChild("PlayerGui")
        local screenGui = pGui and pGui:FindFirstChild("ScreenGui")
        if screenGui then
            local monsterIcon = screenGui:FindFirstChild("MonsterIcon", true)
            if monsterIcon and monsterIcon.Visible then
                if monsterIcon:IsA("ImageLabel") or monsterIcon:IsA("ImageButton") then
                    if monsterIcon.ImageTransparency < 0.95 then
                        return true -- SIMBOL MATA AKTIF!
                    end
                else
                    return true
                end
            end
        end
    end

    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, monster in pairs(monstersFolder:GetChildren()) do
            local chaseVal = monster:FindFirstChild("ChasingValue")
            if chaseVal and (chaseVal.Value == character or chaseVal.Value == player) then
                return true -- TERKUNCI OLEH MONSTER!
            end
        end
    end

    return false
end

-- Deteksi ancaman monster (mendukung pengecekan posisi karakter maupun mengecek titik generator dari jauh)
local function isThreatened(targetPosition, customRadius)
    local isSelfCheck = (targetPosition == nil)
    local checkPos    = targetPosition or (rootPart and rootPart.Position)
    if not checkPos then return false end

    if isSelfCheck and isPlayerSpotted() then
        return true
    end

    local baseRadius = customRadius or Config.Teleport.SafeRadius or 30
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if monstersFolder then
        for _, monster in pairs(monstersFolder:GetChildren()) do
            if monster:IsA("Model") then
                local chaseVal = monster:FindFirstChild("ChasingValue")
                if isSelfCheck and chaseVal and (chaseVal.Value == character or chaseVal.Value == player) then
                    return true
                end
                local mPart = getMonsterPart(monster)
                if mPart then
                    local dist = (mPart.Position - checkPos).Magnitude
                    if isLethalMonsterName(monster.Name) then
                        if dist <= (Config.Teleport.LethalRadius or 60) then
                            return true
                        end
                    elseif isLooseMonsterName(monster.Name) then
                        if not isSelfCheck and dist <= (Config.Teleport.LooseRadius or 10) then
                            return true
                        end
                    else
                        if dist <= baseRadius then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function isPointNearPassiveMonster(pt, customRadius)
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if not monstersFolder then return false end
    local checkRad = customRadius or (Config.Teleport.LooseRadius or 10)
    for _, m in pairs(monstersFolder:GetChildren()) do
        if m:IsA("Model") and isLooseMonsterName(m.Name) then
            local p = getMonsterPart(m)
            if p and (p.Position - pt).Magnitude <= checkRad then
                return true
            end
        end
    end
    return false
end

local function isItemAreaDangerous(itemPos)
    local map = getMap()
    local monstersFolder = map and map:FindFirstChild("Monsters")
    if not monstersFolder then return false end

    local activeSafeDist  = math.max(Config.Pickup.ItemMonsterSafeDist or 26, (Config.Teleport.SafeRadius or 30))
    local passiveSafeDist = math.max((Config.Teleport.LooseRadius or 10) - 1, 8.5)

    for _, m in pairs(monstersFolder:GetChildren()) do
        if m:IsA("Model") then
            local mp = getMonsterPart(m)
            if mp then
                local distToItem = Vector2.new(mp.Position.X - itemPos.X, mp.Position.Z - itemPos.Z).Magnitude
                if isLethalMonsterName(m.Name) then
                    if distToItem <= (Config.Teleport.LethalRadius or 60) then
                        return true
                    end
                elseif isLooseMonsterName(m.Name) then
                    if distToItem <= passiveSafeDist then
                        return true
                    end
                else
                    if distToItem <= activeSafeDist then
                        return true
                    end
                    if rootPart then
                        local pA = rootPart.Position
                        local ab = itemPos - pA
                        local lenSq = ab.X * ab.X + ab.Z * ab.Z
                        if lenSq > 1 then
                            local t = math.clamp(((mp.Position.X - pA.X) * ab.X + (mp.Position.Z - pA.Z) * ab.Z) / lenSq, 0, 1)
                            local closestPt = pA + ab * t
                            local distToLine = Vector2.new(closestPt.X - mp.Position.X, closestPt.Z - mp.Position.Z).Magnitude
                            if distToLine <= activeSafeDist then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

