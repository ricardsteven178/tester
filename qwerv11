local function executePickup()
    if not Config.Pickup.Enable then return end
    local map = getMap()
    if not map then return end

    applyItemESP()
    updateColliderCaches()

    -- Wajib keluar lurus dari pintu Lift terlebih dahulu sebelum mulai mengejar item di floor baru!
    ensureExitedElevator()
    if abortCurrentMovement or not isMasterFarming then return end

    local skipCounts = {}

    local function makePlatform(atPos)
        local plat = Instance.new("Part")
        plat.Size         = Vector3.new(10, 1, 10)
        plat.Anchored     = true
        plat.CanCollide   = true
        plat.Transparency = 1
        plat.CFrame       = CFrame.new(atPos.X, atPos.Y - 3, atPos.Z)
        plat.Parent       = Workspace
        return plat
    end

    local function getSortedCandidateItems()
        local safeList    = {}
        local guardedList = {}
        local curMap      = getMap()
        local folder      = curMap and curMap:FindFirstChild("Items")
        if not folder or not rootPart then return safeList, guardedList end

        local now   = os.clock()
        local rpPos = rootPart.Position

        for _, item in ipairs(folder:GetChildren()) do
            if item:IsA("Model") and item.Parent and not isIgnored(item.Name) and not item:GetAttribute("BlacklistLimbo") then
                local tier = getItemPriorityTier(item.Name)
                if tier ~= nil then
                    local itemPos       = item:GetPivot().Position
                    local dist          = (rpPos - itemPos).Magnitude
                    local cdAttr        = item:GetAttribute("MonsterCooldownUntil") or 0
                    local isOnCooldown  = (now < cdAttr)
                    local isDangerous   = isOnCooldown or isItemAreaDangerous(itemPos)
                    local weightedScore = dist + ((tier - 1) * 30)

                    local entry = {
                        instance = item,
                        name     = item.Name,
                        tier     = tier,
                        pos      = itemPos,
                        dist     = dist,
                        score    = weightedScore,
                    }

                    if isDangerous then
                        if not isOnCooldown then
                            item:SetAttribute("MonsterCooldownUntil", now + 6.0)
                        end
                        table.insert(guardedList, entry)
                    else
                        table.insert(safeList, entry)
                    end
                end
            end
        end

        local function sortFn(a, b) return a.score < b.score end
        table.sort(safeList, sortFn)
        table.sort(guardedList, sortFn)
        return safeList, guardedList
    end

    while isMasterFarming and not abortCurrentMovement do
        -- 0. Jika UseVeeRemoteFirst == true dan VeeRemote masih "Active", tunda ambil item agar fokus pakai VeeRemote dulu
        local curGenCheck = getMachineProgress()
        if Config.Teleport.UseVeeRemoteFirst and isTrinketActive() and (curGenCheck == 0) then
            break
        end

        -- 1. Cek Hirarki Tertinggi HANYA jika karakter kita sendiri benar-benar ter-spot / monster masuk SafeRadius
        if isThreatened() then
            local okHide = performColliderHide("Ter-spot monster saat proses Pickup Item!")
            if not okHide or abortCurrentMovement or not isMasterFarming then break end
        end

        local safeCandidates, guardedCandidates = getSortedCandidateItems()
        if #safeCandidates == 0 and #guardedCandidates == 0 then
            break
        end

        local chosen = safeCandidates[1]

        -- 2. Jika tidak ada item yang aman (semua item sisa sedang dekat monster),
        -- langsung tinggalkan dulu selama 6 detik (MonsterCooldownUntil) dan lanjut kerjakan Generator!
        if not chosen then
            if Config.Pickup.MovementMode == "Instant" then
                chosen = guardedCandidates[1]
            else
                print("[SMART PICKUP] Item sisa (" .. guardedCandidates[1].name .. ") sedang dekat monster. Lanjut ke Generator dulu...")
                break
            end
        end

        local item       = chosen.instance
        local itemPos    = chosen.pos
        local itemStandY = getTargetStandingY(itemPos.Y, false)
        local targetCF   = CFrame.new(itemPos.X, itemStandY, itemPos.Z)

        local switchedToOtherItem = false
        local itemPickedOrGone    = false

        local function shouldRerouteToSaferItem()
            if not item or not item.Parent then
                itemPickedOrGone = true
                return true
            end
            if Config.Pickup.MovementMode == "Tween" and isItemAreaDangerous(item:GetPivot().Position) then
                item:SetAttribute("MonsterCooldownUntil", os.clock() + 6.0)
                switchedToOtherItem = true
                return true
            end
            return false
        end

        local moveInterrupted = false
        if Config.Pickup.MovementMode == "Instant" then
            teleportplr(targetCF, false)
        else
            moveInterrupted = safeSingleLayerTween(targetCF, Config.Pickup.TweenSpeed, false, shouldRerouteToSaferItem)
        end

        if abortCurrentMovement or not isMasterFarming then break end

        -- 1) Jika item sudah tersedot oleh Aura 30 studs di tengah jalan, langsung lanjut tanpa sembunyi!
        if itemPickedOrGone or not item or not item.Parent then
            task.wait(0.05)
            continue
        end

        -- 2) Jika item didekati monster di tengah jalan, langsung ganti ke item aman lain tanpa sembunyi!
        if switchedToOtherItem then
            if isThreatened() then
                local okHide = performColliderHide("Ter-spot monster saat mengalihkan rute item!")
                if not okHide or abortCurrentMovement or not isMasterFarming then break end
            else
                print("[SMART PICKUP] Monster mendekati " .. chosen.name .. "! Beralih ke item aman lain...")
            end
            task.wait(0.06)
            continue
        end

        -- 3) Hanya sembunyi jika karakter kita sendiri benar-benar terkena spot / monster masuk SafeRadius kita!
        if isThreatened() then
            local okHide = performColliderHide("Ter-spot saat jalan menuju item " .. chosen.name .. "!")
            if not okHide or abortCurrentMovement or not isMasterFarming then break end
            task.wait(0.08)
            continue
        end

        local horizDist = Vector2.new(rootPart.Position.X - itemPos.X, rootPart.Position.Z - itemPos.Z).Magnitude
        if moveInterrupted or horizDist > 11.5 then
            skipCounts[item] = (skipCounts[item] or 0) + 1
            if skipCounts[item] >= 3 and not isPriority(item.Name) then
                item:SetAttribute("BlacklistLimbo", true)
            end
            task.wait(0.08)
            continue
        end

        -- 4. Eksekusi ambil item dengan Server-Synced Hold (Cek monster setiap 0.04 detik agar refleks instan!)
        local holdTargetPos      = rootPart.Position
        local plat               = makePlatform(holdTargetPos)
        local holdPickupConn     = startServerSyncedHold(function() return holdTargetPos end)
        local waitTicks          = 0
        local monsterInterrupted = false

        while item.Parent and waitTicks < 24 and not abortCurrentMovement and isMasterFarming do
            if isThreatened() then
                monsterInterrupted = true
                break
            end
            if Config.Pickup.MovementMode == "Tween" and isItemAreaDangerous(itemPos) then
                item:SetAttribute("MonsterCooldownUntil", os.clock() + 6.0)
                switchedToOtherItem = true
                break
            end

            local pp   = item:FindFirstChild("Prompt")
            local prox = pp and pp:FindFirstChild("ProximityPrompt")
            if prox and prox.Enabled then
                interactWithPrompt(prox)
            end

            task.wait(0.04)
            waitTicks = waitTicks + 1
        end

        if holdPickupConn then holdPickupConn:Disconnect(); holdPickupConn = nil end
        if plat and plat.Parent then plat:Destroy() end
        if rootPart then rootPart.Anchored = false end

        if monsterInterrupted then
            local okHide = performColliderHide("Ter-spot saat memungut item " .. chosen.name .. "!")
            if not okHide or abortCurrentMovement or not isMasterFarming then break end
            task.wait(0.08)
            continue
        end

        if switchedToOtherItem then
            task.wait(0.06)
            continue
        end

        if item.Parent then
            skipCounts[item] = (skipCounts[item] or 0) + 1
            if skipCounts[item] >= 2 then
                if isPriority(item.Name) then
                    print("[SYSTEM] Item Priority " .. item.Name .. " belum terambil, akan dicoba lagi.")
                else
                    print("[SYSTEM] Gagal mengambil " .. item.Name .. " (Tas Penuh). Masuk Blacklist lantai ini.")
                    item:SetAttribute("BlacklistLimbo", true)
                    local highlight = item:FindFirstChild("ItemESP")
                    if highlight then highlight.FillColor = Color3.fromRGB(255, 0, 0) end
                end
            end
        end

        restoreNormalGravity()
        task.wait(0.06)
    end

    clearAllServerSyncedHolds()
    if rootPart then rootPart.Anchored = false end
    setTargetColliderPassable(nil, false)
    restoreNormalGravity()
    print("[DONE] Pengambilan item selesai. Melanjutkan ke target Generator...")
end

