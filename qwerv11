    if rangeDangerFill then pcall(function() rangeDangerFill:Destroy() end); rangeDangerFill = nil end
    if rangeDangerRing then pcall(function() rangeDangerRing:Destroy() end); rangeDangerRing = nil end
    if rangeLooseRing  then pcall(function() rangeLooseRing:Destroy() end);  rangeLooseRing  = nil end
end

local function updateSafeRadiusVisual()
    local showRange = (Config.RangeESP ~= false) and (Config.GenESP.ShowSafeRadius ~= false)
    if not showRange or not rootPart or not isMasterFarming then
        clearSafeRadiusVisual()
        return
    end

    local dangerRad     = Config.Teleport.SafeRadius or 30
    local looseRad      = Config.Teleport.LooseRadius or 10
    local threatenedNow = isThreatened()

    local mainColor = threatenedNow and Color3.fromRGB(255, 55, 55) or Color3.fromRGB(45, 255, 115)
    local flatAngle = CFrame.new(0, -2.6, 0) * CFrame.Angles(math.rad(90), 0, 0)

