-- [UPGRADE POIN #2]: Force-Stop Instan (0.00s) - Melepas Kunci Mesin di Server & Client Seketika!
local function forceStop()
    _G.IsBarnabyActive = false
    if not character then return end

    -- 1. Tembak StopInteracting ke mesin di Character.Decoding.Value
    local decodingObj = character:FindFirstChild("Decoding")
    local decoding    = decodingObj and decodingObj.Value
    if decoding ~= nil then
        pcall(function()
            if decoding:FindFirstChild("Stats") and decoding.Stats:FindFirstChild("StopInteracting") then
                decoding.Stats.StopInteracting:FireServer("Stop")
            end
        end)
    end

    -- 2. Tembak StopInteracting ke generator terdekat dalam jarak 14 studs (jaga-jaga jika Decoding.Value telat update)
    local map = getMap()
    local genFolder = map and map:FindFirstChild("Generators")
    if genFolder and rootPart then
        for _, g in ipairs(genFolder:GetChildren()) do
            local stats  = g:FindFirstChild("Stats")
            local stopEv = stats and stats:FindFirstChild("StopInteracting")
            if stopEv then
                local gCF = getGeneratorTargetCFrame(g)
                if gCF and (gCF.Position - rootPart.Position).Magnitude <= 14 then
                    pcall(function() stopEv:FireServer("Stop") end)
                end
            end
        end
    end

    -- 3. Klik tombol UI StopGenerator secara lokal agar script game langsung melepas kunci WalkSpeed = 0 tanpa tunggu ping server!
    local playerGui = player:FindFirstChild("PlayerGui")
    local screenGui = playerGui and playerGui:FindFirstChild("ScreenGui")
    local menu      = screenGui and screenGui:FindFirstChild("Menu")
    local stopGen   = menu and menu:FindFirstChild("StopGenerator")
    if stopGen and stopGen.Visible then
        pcall(function()
            if firesignal then
                pcall(function() firesignal(stopGen.MouseButton1Click) end)
                pcall(function() firesignal(stopGen.Activated) end)
            elseif getconnections then
                for _, conn in pairs(getconnections(stopGen.MouseButton1Click)) do pcall(function() conn:Fire() end) end
                for _, conn in pairs(getconnections(stopGen.Activated)) do pcall(function() conn:Fire() end) end
            end
        end)
    end

    -- 4. Bebaskan RootPart & Humanoid seketika agar langsung bisa sprint kabur!
    if rootPart then
        rootPart.Anchored = false
    end
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = false
        hum.Sit           = false
        if hum.WalkSpeed < 16 then
            hum.WalkSpeed = player:GetAttribute("KM_MAX_PLAYER_SPEED") or 27.5
        end
        if hum:GetState() ~= Enum.HumanoidStateType.Running then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
        end
    end
end

